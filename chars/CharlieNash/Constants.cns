;Normal Quotes
;Charlie
[Quotes]
victory0 = "Are you always so slow?" 
victory1 = "Be all that you can be, scumbag!"
victory2 = "One more down. On with the war." 
victory3 = "You've got talent. Uncle Sam could use you." 
victory4 = "My conclusion: Your chances of wining a rematch are below 5%." 
victory5 = "Your unnecessary movements are opening that lead to defeat!" 
victory6 = "Fighting skill depends on one's ability to anticipate visually." 
victory7 = "I'm sorry... Are mad at me? Did I 'tick' you off? Ha! Ha!" 
victory8 = "Identify tactical inadequacies, then renew your strategy!" 
victory9 = "If you lack essential skills, you may gain them by experience." 
victory10 = "You have no hope if you did not learn anything from our fight!" 
victory11 = "Tracking a target precisely is a basic skill, crucial to victory!" 

