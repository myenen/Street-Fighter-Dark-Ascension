[Data]
life = 2200
attack = 140 
defence = 120 
fall.defence_up = 50
liedown.time = 10    
airjuggle = 1000        
sparkno = 2         
guard.sparkno = 40  
KO.echo = 1           

[Size]
xscale = 1
yscale = 1
ground.back = 35
ground.front = 45
air.back = 20
air.front = 20
z.width = 3
attack.width = 4,4
attack.dist = 160
proj.attack.dist = 2
proj.doscale = 1
shadowoffset = -1

[Velocity]
walk.fwd  = 3
walk.back = -3      
run.fwd  = 4     
run.back = -4  
jump.neu = 0, -8.8     
jump.back = -3.4       
jump.fwd = 3.4
runjump.back = -4,-8.5
runjump.fwd = 4,-8.5     

[Movement]
airjump.num = 2      
airjump.height = 45  
yaccel = .48         
stand.friction = .85 
crouch.friction = .82

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
triggerall = life > 1800
trigger1 = Anim != 10000 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 10000

[State 0, 2]
type = ChangeState
triggerall = IsHelper(6000) = 1
trigger1 = Time = 0
value = 902

[State 0, 1]
type = ChangeAnim
triggerall = life <= 1800
triggerall = life > 800
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 1]
type = ChangeAnim
triggerall = life <= 800
trigger1 = Anim != 5300 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 5300

[State 0, 1]
type = ChangeState
triggerall = stateno != 5151
trigger1 = alive = 0
trigger1 = Time = 0
value = 5151

[State 0, 3]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 4] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

;[State 0, 4] ;Are you dead?
;type = ChangeState
;triggerall = stateno != 5151
;trigger1 = Life = 0
;value = 5151

;---------------------------------------------------------------------------
; Never Die!!!
[Statedef 5151]
type    = S
movetype= I
physics = N
sprpriority = -3
;anim = 5151

[State 5151, 0]
type = ChangeAnim
trigger1 = Time = 0
value = 5151

[State 5151, 1]
type = PlaySnd
trigger1 = AnimElem = 1
value = 5, 3
volume = - 2
channel = 8

[State 5151, 2] ;Friction
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

[State 5151, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = -1

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 1

;[State 100, 0]
;type = CtrlSet
;trigger1 = Time = 0
;value = 1

[State 100, 1]
type = PosAdd
trigger1 = 1
x = 20

[State 100, 3]
type = Turn
trigger1 = p2dist X < -15
trigger1 = command != "holdfwd"

[State 100, 2]
type = Explod
trigger1 = time = 0
persistent = 1
scale = 1.3,1.3
anim = 888
id = 809
pos = 0,5
postype = P1
sprpriority = 5
bindtime = 1
ownpal = 1

[State 100, 2]
type = Palfx
trigger1 = NumExplod(809) = 1
time = 5
add = 20, 20, 50

[State 100, 2]
type = PlaySnd
trigger1 = NumExplod(809) = 1
value = S4, 6

[State 100, 3] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

;[State 100, 3] ;Prevent from turning
;type = AssertSpecial
;trigger1 = 1
;flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0

