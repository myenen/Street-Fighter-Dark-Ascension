;====================================================================
;=											  =
;=				MECH ZANGIEF'S CONSTANT				  =
;=											  =
;=										        =
;====================================================================

[data]
life = 1000          ;amount of life to start with
attack = 100         ;100% attack power (more is stronger)
defence = 150        ;100% Defensive power (more is stronger)
fall.defence_up = 50 ;def goes Up by 50% everytime player is hit on ground
liedown.time = 60    ;time player takes before getting Up From hit_liedown
airjuggle = 15       ;can Do 15 points of juggling
sparkno = 0        ;default spark number
guard.sparkno = 40 ;default guard spark number
ko.echo = 1          ;1 to enable echo on ko
volume = 255          ;volume offset (negative For softer)
IntPersistIndex = 60
FloatPersistIndex = 40

[size]
xscale = 1           ;horizontal scaling Factor.
yscale = 1           ;vertical scaling Factor.
ground.back = 12     ;player width (back, ground)
ground.front = 30    ;player width (front, ground)
air.back = 12        ;player width (back, air)
air.front = 30       ;player width (front, air)
z.width = 3          ;player width (into and out)
height = 60	     ;height of player (for opponent to jump over)
attack.width = 4,4   ;default attack width: back, Front
attack.dist = 160    ;default attack Distance
proj.attack.dist = 90 ;default attack Distance For projectiles
proj.doscale = 0     ;set to 1 to scale projectiles too   

[velocity]
walk.fwd  = 2      ;walk Forward
walk.back = -1.5     ;walk backward
run.fwd  = 4.6, 0    ;run Forward (x, y)  - if y<0, player will hop
run.back = -4.5,-3.8 ;run backward (x, y) - if y=0, player will run
jump.neu = 0,-8.1    ;neutral jumping velocity (x, y)
jump.back = -2.55    ;jump back speed (x, y)
jump.fwd = 2.5       ;jump Forward speed (x, y)
runjump.back = -2.55,-8.1 ;running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55,-8.1 ;air jump speeds (opt)
airjump.fwd = 2.5,-8.1    ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Jump
[statedef 43]
type    = a
movetype= a
physics = a
juggle  = 0
ctrl = 0
velset = -5,-10
anim = 43

[State 43, 1]
type = ChangeAnim
trigger1 = time = 0 && anim != 43 && Prevstateno != 9000
value = 43

[state 43, 2]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

;----------------------------------------------
; Jump Forward
[statedef 63]
type    = a
movetype= a
physics = a
juggle  = 0
ctrl = 0
velset = -5,-10
facep2 = !(prevstateno = 9000)

[State 263, 1]
type = ChangeAnim
trigger1 = time = 0 && anim != 43 && Prevstateno != 9000
value = 43

[state 63, 2]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

;----------------------------------------------
; Jump Out
[statedef 93]
type    = a
movetype= a
physics = a
juggle  = 0
ctrl = 0
velset = 5,10
facep2 = !(prevstateno = 9000)

[State 93, 1]
type = ChangeAnim
trigger1 = time = 0 && anim != 93 && Prevstateno != 9000
value = 93

[state 93, 2]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Walk ; KFM Mech Zangief
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
triggerall = command = "holdfwd"
trigger1 = Var(15) != [6,11]
trigger2 = Var(15) != [37,42]
x = const(velocity.walk.fwd.x)*(Var(15) != [6,11])*(Var(15) != [37,42])*(Var(15) != [67,73])

[State 20, 2]
type = VarSet
trigger1 = time = 0
trigger2 = Var(15) = 73
trigger3 = command != "holdfwd"
v = 15
value = 0 + 43*(Var(15) = 73)

[State 20, 3]
type = VarAdd
trigger1 = command = "holdfwd"
v = 15
value = 1

[State 20, 4]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 5]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 6]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;----------------------------------------------
; Lose (time over)
[statedef 170]
type = s
ctrl = 0
anim = 142
velset = (prevstateno = 9000)* .25,(prevstateno = 9000)* 0
facep2 = !(prevstateno = 9000)

[state 170, 1]
type = nothitby
trigger1 = time >= 0
value = sca
time = 1

;---------------------------------------------------------------------------
; Win
[statedef 180]
type = s
velset = (prevstateno = 9000)* .25,(prevstateno = 9000)* 0
facep2 = !(prevstateno = 9000)

[state 180, 1]
type = changestate
trigger1 = time = 0
value = 181

;---------------------------------------------------------------------------
; Win 1
[statedef 181]
type = s
ctrl = 0
anim = 181
velset = (prevstateno = 9000)* .25,(prevstateno = 9000)* 0
facep2 = !(prevstateno = 9000)

[state 181, 0]
type = playsnd
trigger1 = time = 0
value = 10,0

[state 181, 1]
type = nothitby
trigger1 = time >= 0
value = sca
time = 1

;---------------------------------------------------------------------------
; Intro
[statedef 191]
type = s
ctrl = 0
anim = 190
velset = (prevstateno = 9000)* .25,(prevstateno = 9000)* 0
facep2 = !(prevstateno = 9000)

[state 191, 1]
type = playsnd
trigger1 = animelem = 2
value = 1,2

[state 191, 2] ;intro not yet over
type = varset
trigger1 = time = 0
v = 9
value = 1

[state 191, 3] ;intro over, set v9 to 1
type = varset
trigger1 = time = 60
v = 9
value = 0

;----------------------------------
; Taunt
[statedef 95]
type    = s
movetype= a
physics = s
ctrl = 0
velset = (prevstateno = 9000)* .25,(prevstateno = 9000)* 0
facep2 = !(prevstateno = 9000)
juggle = 4

[State 95, 1]
type = ChangeAnim
trigger1 = time = 0 && anim != 95 && Prevstateno != 9000
value = 95

[state 95, 2]
type = playsnd
trigger1 = time = 0
value = 10,4

[state 95, 7] 
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

;------------------------------------------
; Dash
[statedef 100]
type    = s
movetype= a
physics = s
ctrl = 0
poweradd = 20
sprpriority = 2

[State 100, 1]
type = ChangeAnim
trigger1 = time = 0 && anim != 100 && Prevstateno != 9000
value = 100

[state 100, 2]
type = velset
trigger1 = animelem = 2, >= 0
x = 4

[state efect]
type = explod
trigger1 = timemod = 10,2
anim = 703
postype = p1
sprpriority = 2
pos = var(55),var(56)

[state v]
type = varrandom
trigger1 = 1
v = 55
range = -110,40

[state v]
type = varrandom
trigger1 = 1
v = 56
range = -80,-20

[state 100, 3]
type = hitdef
trigger1 = time = 0
attr = a, nt
getpower  = 70
hitflag = m- ;mafd
priority = 1
snap = 0,-1,0, -1 ;x,y,z, bindtime (def 0)
hitsound = 6,0
sparkno = -1
p2facing = 1
p1stateno = 840
p2stateno = 850

[state 100, 4]
type = ctrlset
trigger1 = animtime = 0
value = 1

[state 100, 5]
type = changestate ;-=-=-=-=-
trigger1 = animtime = 0
trigger1 = pos y < 0
value = 50

[state 100, 7]
type = posset ;-=-=-=-=-
trigger1 = vel y > 0
trigger1 = pos y > 0
y = 0

[state 100, 8]
type = changestate
trigger1 = animtime = 0
value = 101

;--------------------------------
; Grab
[statedef 840]
type = s
movetype = a
physics = s
juggle = 1
velset = (prevstateno = 9000)* .25,(prevstateno = 9000)* 0
facep2 = !(prevstateno = 9000)
ctrl = 0

[State 101, 1]
type = ChangeAnim
trigger1 = time = 0 && anim != 9997 && Prevstateno != 9000
value = 9997

[state 101, 2]
type = playsnd
trigger1 = time = 0
value = 9,4

[state 101, 3]
type = velset
trigger1 = time = 0
x = 0
y = 0
z = 0


[state 101, 4]
type = changestate
trigger1 = time = 130
value = 0
ctrl = 1

[state 1106, 8]
type = targetbind
trigger1 = time = 0
time = 140


[State 3100, 1]
type = Changestate
trigger1 = (time < 100) && ((command = "x") || (command = "y") || (command = "z"))
value = 3008

[State 3100, 1]
type = ChangeState
trigger1 = (time < 100) && ((command = "a") || (command = "b") || (command = "c")) 
value = 2105

[State 3100, 1]
type = ChangeState
trigger1 = (time < 100) && (command = "relup")
value = 930

;------------------------------------
; Get Grab
[statedef 850]
type = s
movetype = h
physics = n
ctrl = 0
velset = 0

[State 1520]
type= ChangeAnim2
trigger1 = time = 0
value = 855

[State 1531, 5]
type = PosFreeze
trigger1 = time >= 0

[State 1520]
type= velset
trigger1 = time = 130
x= -5
y= -7

[State 810, State]
type = SelfState
trigger1 = Time = 130
value = 5040
ctrl = 1

