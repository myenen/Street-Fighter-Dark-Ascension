;===============================================================================
;MvC Custom by Scar
;===============================================================================
;Var (0) = Super Jump
;Var (1) = Command input dection
;Var (2) = Super Combo (Removed)
;Var (7) = Floor Possition
;Var(8 - 10) = Announcer Text
;Var (11) = Super Jump Direction
;Var (12) = Super Jump
;Var (17) = Screen Pack
;Var (21) = Combo Mute
;Var (28) = Taunt
;Var (30) = Recovery Roll
;Var (59) = AI On

[Data]
life = 1000
attack = 130
defence = 100
fall.defence_up = 50
liedown.time = 50
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 555
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = .25  ;1
yscale = .25  ;1
ground.back = 20
ground.front = 20
air.back = 18
air.front = 22
height = 60
attack.dist = 160
attack.width = 4,4   
proj.dist = 90
proj.attack.dist = 90 
proj.doscale = 0
head.pos = 1, -83
mid.pos = 1, -53
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd = 3.6
walk.back = -2.7
run.fwd = 6
run.back = -8,-3
jump.neu = 0,-9.0
jump.back = -3.7
jump.fwd = 3.2
runjump.fwd = 4.4
runjump.back = -4.4
airjump.neu = 0, -8.9
airjump.fwd = 2.5
airjump.back = -2.55

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .41
stand.friction = .80
crouch.friction = .80
air.friction = .80

;-------------------------------------------------------------------------------
;Dash Foward
[Statedef 100]
type    = S
physics = N
anim = 100
sprpriority = 1
velset = 7, 0

[State 100,1]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100,2]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100,3]
type = PlaySnd
trigger1 = time = 3
value = s1100,1

[State 100,4]
type = PlaySnd
trigger1 = time = 19
value = s8100,0

[State 100,5]
type = Explod
trigger1 = time < 15
trigger1 = (time % 4) = 1
ID = 41
anim = 2222
postype = p1
pos = -50,-60
removetime = -2
vel = -1, 0
random = 20, 60
sprpriority = 5

[State 100,6]
type = Explod
trigger1 = time < 15
trigger1 = (time % 4) = 0
ID = 42
anim = 2222
postype = p1
pos = -50,-50
removetime = -2
vel = -.8, 0
random = 20, 60
sprpriority = 5

[State 100,7]
type = Explod
trigger1 = time < 15
trigger1 = (time % 4) = 0
anim = 2223
ID = 2223
pos = -35,0
scale = .8,.8
sprpriority = 5
ignorehitpause = 1

[State 100,8]
type = VelAdd
triggerall = Vel X > 0
trigger1 = time > 15
x = -.3

[State 100,9]
type = ChangeState
trigger1 = !AnimTime
value = 0

