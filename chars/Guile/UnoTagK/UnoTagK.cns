[State 1251102, Turn]
type = Null
triggerall = Time = [0,1]
triggerall = NumEnemy && EnemyNear,StateNo != [1251112,1251114]
trigger1 = Facing = -1 && Pos X < EnemyNear,Pos X	;((EnemyNear,Pos X-95) >= Partner,Pos X)
trigger2 = Facing = 1 && Pos X > EnemyNear,Pos X	;((EnemyNear,Pos X +95) <= Partner,Pos X)

[State 1251102, Turn]
Type = Turn
triggerall = NumEnemy
Trigger1 = Facing = 1
