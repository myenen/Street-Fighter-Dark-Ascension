		sprPriority: -2;
		posType: p1;
		scale: 0.75, 0.75;
		ownpal: 1;
		pausemovetime: -1;
		supermovetime: -1;
	}
}

# Dust
if !pos y && animElemTime(7) < 0 && !(animElemTime(1) % 5) {
	explod{
		anim: 7103;
		id: 7103;
		sprPriority: 3;
		posType: p1;
		vel: 1, 0;
		ownpal: 1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
	}
}

if !animTime {
	# Turn
	turn{}
	# End
	changeState{value: 0; ctrl: 1}
}

#----- TARGET -----

#============================================================
# State 865
#============================================================
[StateDef 865;
	type: A;
	physics: N;
	moveType: H;
	velSet: 0, 0;
	sprPriority: 0;
]

# Anim
if !time {
	changeAnim2{value: 865}
}

# Camera
screenBound{value: 1; movecamera: 0, 0}

# Safety
if time >= 180 {
	selfState{value: 5040}
}

#============================================================
# State 866
#============================================================

[StateDef 866;
	type: A;
	physics: N;
	moveType: H;
	velSet: 0, 0;
	sprPriority: 0;
]

# Anim
if !time {
	changeAnim2{value: 866}
}

# Camera
screenBound{value: 1; movecamera: 0, 0}

# Safety
if time >= 180 {
	selfState{value: 5040}
}

#============================================================
# State 867
#============================================================

[StateDef 867;
	type: A;
	physics: N;
	moveType: H;
	velSet: 6, -9;
]

# Accel
veladd{
	y: 0.4850; # yaccel
}

# Dizzy Start
if alive
&& life > 0
&& dizzypoints <= 0
&& !getHitVar(isbound) {
	dizzyset{value: 1}
}

# Fall Recovery
if (alive = 1 && dizzy = 0 && dizzypoints > 0)
&& getHitVar(fall.recover)
&& command = "recovery"
&& vel y > 0
&& pos y >= const(movement.air.gethit.groundrecover.ground.threshold) {
	selfState{value: 5200}
}

# Hit Ground
if vel y > 0
&& pos y >= 0 {
	selfState{value: 5100}
}

# Offset
if anim = 866
&& animElemTime(6) >= 0
&& animElemTime(7) < 0 {
	offset{y: const(size.mid.pos.y)}
}

#=======================<Target Escaped>========================

#============================================================
# State 890
#============================================================
[StateDef 890;
	type: S;
	physics: N;
	moveType: I;
	anim: 890;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 0;
]

# Tech Hit Facing
if !time
&& facing != map(throwtech_facing) {
	turn{}
}

if !time
&& numTarget = 1 {
	# Bind
	targetbind{pos: (const(size.ground.front) + target, const(size.ground.front)), 0}
	# Width
	width{edge: (target, const(size.ground.front) + target, const(size.ground.back)), 0}
}

if !time
&& numTarget {
	# P2 State
	targetState{value: 895}
	# Throw
	targetfacing{value: -1}
}

# NHB
notHitBy{value: SCA; time: 1}
# Push
playerPush{value: 0}

# Pos
if !time {
	posSet{y: 0}
}

# Vel
velSet{x: -1.281; y: 0}

# Vel Corner
if numEnemy
&& p2, vel x < 0
&& p2, backedgedist <= 0 {
	velSet{x: -2.562; y: 0}
}

# Sound
if time = 2 {
	playSnd{value: 5000, 0; channel: 0}
}

# FX
if !time {
	playSnd{value: 0, 890}
	explod{
		id: 8200;
		anim: 8200;
		posType: p1;
		pos: const(size.ground.front), -48;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
		ontop: 1;
	}
}

# End
if time >= 26 {
	changeState{value: 0; ctrl: 1}
}

