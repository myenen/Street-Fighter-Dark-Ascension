	type: S;
	physics: N;
	moveType: I;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
]

# Anim
if !time {
	changeAnim{value: ifelse(selfanimexist(5940), 5940, ifelse(selfanimexist(200), 200, 130))}
}

# Anim
if anim = 130
&& time >= 20 {
	changeAnim{value: 140}
}

# Anim
if anim = 200
&& animTime = -1 {
	changeAnim{value: 200; elem: animElemno(-1)}
}

# NHB
notHitBy{value: SCA; time: 1}
# Push
playerPush{value: 0}

# Pos
if !time {
