		sparkxy: 20, 0;
		numhits: 0;
	}
}

# Reversal
if anim = 1501
&& animElem = 3 {
	reversalDef{
		reversal.attr: SC, AA;
		p1stateno: 1510;
		pausetime: 12, 36;
		hitsound: s2, 0;
		sparkno: ifelse(map(cfg_sparks), -1, 40) + 0 * (map(sparkno) := -1);
		sparkxy: 20, 0;
		numhits: 0;
	}
}

# Idle
if animElem = 4 {
	stateTypeSet{moveType: I}
}

# End
