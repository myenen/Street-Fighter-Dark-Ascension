# Layering
if sprPriority > parent, sprPriority {
	sprPriority{value: parent, sprPriority}
}

# Fade in
ignoreHitPause if time < 4 {
	trans{trans: addAlpha; alpha: 64 * (time + 1), 256}
}

# Particles
let particle_x = -40 + random / 13.33;
explod{
	id: 6005;
	anim: 6005;
	posType: p1;
	pos: $particle_x, -65 - 25 * cos($particle_x / 40.0 * pi); # follow aura outline
	random: 0, 0;
	vel: 0.01 * $particle_x, -1;
	accel: 0, -0.1;
	sprPriority: parent, sprPriority + 1;
	removetime: 20;
	scale: 0.33, 0.33;
	angle: 15 * (random % 24);
	pausemovetime: p2, pausetime;
	supermovetime: p2, pausetime;
}

# End
if (var(0) = 192
&& (parent, stateno = 192 && parent, animElemTime(26) >= 0))
|| (var(0) = 195
&& (parent, stateno = 195 && parent, animElemTime(19) >= 0)) {
	changeState{value: 6001}
}

# End
if parent, anim != var(0)
|| (parent, stateno = 1020 && parent, animElemTime(9) >= 0)
|| (parent, stateno = 1400 && parent, animElemTime(6) >= 0)
|| (parent, stateno = 3020
&& (parent, anim = 3020 && parent, animElemTime(22) >= 0))
