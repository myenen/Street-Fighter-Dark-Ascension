trigger1 = 1
flag = NoAutoTurn

[State 101, 8]
type = PlaySnd
trigger1 = Time = 12
value = 0, 3

[State 101, 9]
type = PlaySnd
trigger1 = Time = 1
value = 200 + var(30), 0
channel = 0

[State 101, 10]
type = Explod
trigger1 = time = [2,16]
trigger1 = Timemod = 2, 0
anim = 110 + random % 5
postype = p1
pos = -40, -50
vel = -3, 0
random = 20, 80
removetime = 14
sprpriority = 2
ownpal = 1

[State 101, 11]
type = Explod
trigger1 = time >= 10
trigger1 = Timemod = 4, 2
anim = 115
postype = p1
pos = 0, 0
vel = -.5, 0
removetime = 13
sprpriority = 2
ownpal = 1

[State 101, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

