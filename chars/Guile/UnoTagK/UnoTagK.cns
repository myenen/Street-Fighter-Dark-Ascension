;--------------------------------------------------------------------------------------------------------------------------------------------
;ENTERING THE SCREEN
[StateDef 1251101]
type = A
movetype = I
physics = N
sprpriority = 2
anim = 42
ctrl = 0

[State 1251101, VarSet]
type = VarSet
trigger1 = Anim != 42
var(45) = 0

[State 1251101, VarSet]
type = VarSet
trigger1 = Anim = 42
var(45) = 1

[State 1251101, Explod]
type = Explod
trigger1 = Anim = 42
trigger1 = Pos Y <= 0
trigger1 = !NumExplod(7000)
ID = 7000
anim = 7000
postype = P1    ;p2,front,back,left,right
pos = 0,8
supermovetime = 0
pausemovetime = 0
scale = .4,.4
sprpriority = -4
ownpal = 1
persistent = 0

[State 1251101, Explod]
type = Explod
trigger1 = Anim = 42
trigger1 = Vel Y < 0
trigger1 = !NumExplod(7001)
ID = 7001
anim = 7001
postype = P1    ;p2,front,back,left,right
pos = 0,8
supermovetime = 0
pausemovetime = 0
scale = .4,.4
sprpriority = -4
ownpal = 1
persistent = 0

[State 1251101, PlaySnd]
type = PlaySnd
trigger1 = Anim = 42
trigger1 = AnimElem = 1
value = S40,0
channel = -1

[State 1251101, Turn]
type = Turn
trigger1 = (IsHelper(1251101) || IsHelper(1251102))
trigger1 = Time = [0,1]
trigger1 = Facing != Root,Facing

[State 1251101, AfterImageTime]
type = AfterImageTime
trigger1 = 1
time = 0

[State 1251101, PosSet]
type = PosSet
triggerall = NumPartner
triggerall = Time = 0
triggerall = !(IsHelper(1251101) || IsHelper(1251102))
trigger1 = (Partner,StateNo = 1251125)
trigger2 = (Partner,PrevStateNo = 1251110)
trigger3 = (Partner,StateNo = 1251128)
x = (55+(GameWidth/2))*(-1*Facing)
y = ((Partner,BackEdgeBodyDist+20)*-1)/2

[State 1251101, PosSet]
type = PosSet
trigger1 = (IsHelper(1251101) || IsHelper(1251102))
trigger1 = Time = [0,1]
x = (55+(GameWidth/2))*(-1*Facing)
y = ((Abs(Root,Pos Y)+Root,BackEdgeBodyDist+20)*-1)/2

[State 1251101, VelSet]
type = VelSet
triggerall = NumPartner
trigger1 = Partner,sysvar(4) = 1 || Partner,sysvar(4) = 15 || (Partner,sysvar(4) = 2 && Partner,StateNo = 1251125)
trigger2 = (IsHelper(1251101) || IsHelper(1251102))
x = Cond((IsHelper(1251101) || IsHelper(1251102)),((Abs(BackEdgeDist)+Abs(Pos Y*2))/11),(Abs(Pos X-Partner,Pos X)*.1*Const(Movement.Yaccel)*(RoundState = 2)*1.4))
y = Cond((IsHelper(1251101) || IsHelper(1251102)),(Abs(Root,BackEdgeBodyDist)/25),(Abs(Pos Y)*.1*Const(Movement.Yaccel)*1.4))
persistent = 0

[State 1251101, NotHitBy]
type = NotHitBy
trigger1 = BackEdgeBodyDist <= 0 || (IsHelper(1251101) || IsHelper(1251102))
value = SCA
time = 2+((IsHelper(1251101) || IsHelper(1251102))*99999)

[State 1251101, NotHitBy]
type = NotHitBy
triggerall = NumPartner
trigger1 = Partner,sysvar(4) = 6
trigger2 = Partner,StateNo = 1251128 || Partner,PrevStateNo = 1251128
value = SCA
time = 15

[State 1251101, NotHitBy]
type = NotHitBy
trigger1 = NumPartner
trigger1 = Partner,Life <= 0
value = SCA
time = 6

[State 1251101, ScreenBound] 
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[State 1251101, AssertSpecial]
type = AssertSpecial
trigger1 = NumPartner
trigger1 = !(IsHelper(1251101) || IsHelper(1251102))
trigger1 = Partner,StateNo = 1251110
flag = Invisible

[State 1251101, VelSet]
type = VelSet
trigger1 = Vel Y >= 0
trigger1 = Pos Y > 0
x = 0
y = 0

[State 1251101, VelMul]
type = VelMul
triggerall = NumPartner
trigger1 = Partner,StateNo = 1251109
trigger2 = Partner,StateNo = 1251114
x = .75

[State 1251101, DestroySelf]
type = DestroySelf
triggerall = (IsHelper(1251101) || IsHelper(1251102))
trigger1 = Vel Y >= 0
trigger1 = Pos Y >= 0
trigger2 = Root,Facing = 1 && Pos X >= Root,Pos X-10
trigger3 = Root,Facing = -1 && Pos X <= Root,Pos X+10
trigger4 = !Root,Life

[State 1251101, ChangeState]
type = ChangeState
triggerall = !(IsHelper(1251101) || IsHelper(1251102))
trigger1 = Vel Y >= 0
trigger1 = Pos Y >= 0
value = 1251121

