;Fly up (Flying Start)
[Statedef 1999]
type = A
movetype = I
physics = N
ctrl = 0
velset = 0,-4

[State 1999, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0 && Anim != 3
value = 3

[State 3080, VarSet]
type = VarSet
trigger1 = Time = 0
var(24) = 900

[State 1999, Fly]
type = ChangeState
trigger1 = prevstateno = [5000,5030]
value = 50
ctrl = 1

;will go to state 3080 as soon as the move has ended.
[State 1999, Fly]
type = ChangeState
trigger1 = Pos Y <= -100
value = 3080
