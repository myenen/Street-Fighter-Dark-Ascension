#==============================================================================================
#=======================================<HELPER STATES>========================================
#==============================================================================================

#========================<GOU HADOU KEN>=============================

#============================================================
# State 1005
#============================================================
[StateDef 1005;
	type: S;
	physics: N;
	moveType: A;
	anim: 1005;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 3;
]

ignoreHitPause {
	# Override
	hitOverride{time: -1; attr: SCA, AA, AP, AT; stateno: 1006}
	# HB
	hitBy{time: -1; value: SCA, NP, SP, HP}
}

# Strength
if !time && !prevStateNo {
	mapSet{map: "strength"; value: root, map(strength)}
}

# Vel
velSet{x: ifelse(map(strength) = 2, 5, ifelse(map(strength) = 1, 4.17, 3.33)); y: 0}

# Size
if time < 4
&& !prevStateNo {
	angleDraw{scale: 0.5 + (0.125 * time), 1}
}

# Trans
ignoreHitPause {
	trans{trans: addAlpha; alpha: 256 - 32 * (gametime % 3), 256}
}

# Hit
hitdef{
	#id: stateNo;
	attr: S, SP;
	hitflag: MAF;
	guardflag: MA;
	priority: 4, Hit;
	air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
	damage: 60, 15;
	dizzypoints: 50 * !(root, map(customcombo));
	getpower: 0, 0;
	givepower: 40, 40;
	pausetime: 0, 12;
	animtype: Hard;
	ground.type: High;
	ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
	ground.slidetime: 18;
	guard.hittime: 1 + 16;
	guard.ctrltime: 1 + 16;
	guard.slidetime: 16;
	airguard.ctrltime: 1 + 16;
	ground.velocity: -10.52, 0;
	ground.cornerpush.veloff: 0;
	air.velocity: -0.75 * vel x, -6;
	airguard.velocity: -6.00, -1.00;
	guard.dist: const(size.proj.attack.dist);
	yaccel: 0.4850;
	fall: 0; #var(1) <= 12;
	air.fall: 1;
	fall.recover: 1;
	fall.recovertime: 120;
	forcestand: 1;
	guardsound: s2, 0;
	guardsound.channel: 2;
	sparkno: -1 + 0 * (map(sparkno) := 8013);
	guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
	sparkxy: -10 + 0 * (map(sparkx.min) := -30) * (map(sparkx.max) := 0), map(sparky) := 0;
	envshake.time: 12; # special;
	envshake.freq: 180;
	envshake.ampl: ifelse((gametime % 2), -2, 2);
	envshake.decay: 1.0; # envshake.mul = 0.667;
}

# Connected
ignoreHitPause if moveContact || moveReversed {
	changeState{value: 1006}
}

# End
if frontedgedist < -100 || backedgedist < -80 {
	destroySelf{}
}

#----- Hitpause -----

#============================================================
# State 1006
#============================================================
[StateDef 1006;
	type: A;
	physics: N;
	moveType: A;
	ctrl: 0;
	sprPriority: 3;
	moveHitpersist: 1;
]

# Freeze
posfreeze{value: 1}

# Getpower
ignoreHitPause if moveContact = 1 && numTarget {
	powerAdd{value: ifelse(moveguarded, 25, 50) * root, map(meterscaling)}
}

# HitSound
ignoreHitPause if !time
&& moveHit {
	playSnd{value: 2, ifelse(numTarget, 7, 0); channel: 2}
}

# ProjContact
ignoreHitPause if moveContact = 1
&& p2, getHitVar(frame)
&& (p2, getHitVar(playerID) = ID || moveHitVar(playerID) = p2, ID) {
	map(projcontact) := 1;
	if root, stateno = 1000 {
		root, map(projcontact) := 1;
	}
}

# End
if time >= 0 {
	changeState{value: 1007}
}

#----- Disappear -----

#============================================================
# State 1007
#============================================================
[StateDef 1007;
	type: A;
	physics: N;
	moveType: I;
	anim: 3006;
	velSet: 0, 0;
	ctrl: 0;
	sprPriority: 3;
	moveHitpersist: 1;
]

# Trade Sound
if !time
&& (hitoverridden || prevmoveType = H) {
	playSnd{value: 2, 0; channel: 2; volumescale: 33}
}

# Trans
ignoreHitPause {
	trans{trans: addAlpha; alpha: 256, 256}
}

# End
if !animTime {
	destroySelf{}
}

