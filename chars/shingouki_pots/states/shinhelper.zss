		removetime: 8;
		pausemovetime: -1;
		supermovetime: -1;
	}
}

# Fade
if numexplod(10) {
	modifyexplod{
		id: 10;
		trans: addAlpha;
		alpha: ifelse(time < 16, 256, 256 -32 * (time -16)), ifelse(time < 16, 0, 32 * (time -16));
	}
}

# Fade
if numexplod(11) {
	modifyexplod{
		id: 11;
		scale: 0.5 + (0.0625 * time), (0.5 + (0.0625 * time)) * (1.3333333 * gameheight / gamewidth);
		trans: addAlpha;
		alpha: 256 - (32 * time), 32 * time;
	}
}

# Stop Shake
if time <= 24 {
	envshake{time: 1; ampl: 0}
}

# Assert
if time < 24 {
	assertSpecial{flag: nobardisplay}
}

# End
if numexplod
&& time >= 24
&& roundState != 3 {
	removeexplod{}
}

# End
if time >= 24
&& roundState != 3 {
	destroySelf{}
}

#========================<KANJI FLAMES B.G.>=============================

#============================================================
# State 8690
#============================================================
[StateDef 8690;
	physics: N;
	velSet: 0, 0;
	anim: 9999;
]

# Sound
if !time {
	playSnd{value: 7, 7}
}

# black
if time < 120 {
	bgPalFx{time: 2; add: -255, -255, -255}
}

# black
if time = 120 {
	bgPalFx{time: 60; add: -255, -255, -255; sinadd: 255, 255, 255, 240}
}

# Fade
if time >= 120 {
	modifyexplod{trans: addAlpha; alpha: 256 - floor(4.267 * (time - 120)), 256}
}

# Kanji
if !time {
	explod{
		anim: 8690;
		id: 8690;
		under: 1;
		posType: left;
		pos: 160, ifelse((gamewidth / gameheight) > 1.55, 90, 120);
		scale: 0.5 * (1.3333333 * gameheight / gamewidth), 0.5 * (1.3333333 * gameheight / gamewidth);
		bindtime: -1;
	}
}

# Shrink
if numexplod(8690)
&& time < 12 {
	modifyexplod{
		id: 8690;
		scale: ((13 - time) / 2.0) * (1.3333333 * gameheight / gamewidth), ((13 - time) / 2.0) * (1.3333333 * gameheight / gamewidth);
	}
}

# Shrink
if numexplod(8690)
&& time >= 12 {
	modifyexplod{
		id: 8690;
		scale: 0.5 * (1.3333333 * gameheight / gamewidth), 0.5 * (1.3333333 * gameheight / gamewidth);
	}
}

# Flame BG Fake Afterimage
if time = 0
|| time = 2
|| time = 4 {
	explod{
		anim: 8691;
		under: 1;
		posType: left;
		pos: 160, ifelse((gamewidth / gameheight) > 1.55, 90, 120);
		scale: 1, 1.3333333 * (gameheight / gamewidth);
		trans: addAlpha;
		alpha: 128, 256;
		bindtime: -1;
		removetime: 600;
		pausemovetime: 300;
		supermovetime: 300;
	}
}

# Assert
if time < 120 {
	assertSpecial{flag: nomusic; flag2: globalnoshadow}
}

# Assert
assertSpecial{flag: noFG; flag2: nobardisplay}

if time >= 180 {
	# Safety
	removeexplod{}
	# End
	destroySelf{}
}

#========================<CAMERA CONTROL>=============================

#============================================================
# State 8999
#============================================================
[StateDef 8999;
	physics: N;
	velSet: 0, 0;
	anim: 9999;
]

# Bound
screenBound{value: 0; movecamera: 1, 1}

# End
if roundState = 2 {
	destroySelf{}
}
