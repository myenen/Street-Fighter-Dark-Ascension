	}
	# Sound
	playSnd{value: F 7, 2}
}

# End
if animElemTime(7) >= 110 {
	selfState{value: ifelse(alive, 5120, 5150)}
}

#======================<KONGOU KOKURETSU ZAN>=============================

#============================================================
# State 4200
#============================================================
[StateDef 4200;
	type: S;
	physics: S;
	moveType: A;
	anim: 4200;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: -1;
	facep2: 1;
	powerAdd: -2000 + 0 * (map(superlevel) := 2);
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: ifelse((prevStateNo = [3000, 4999]), 3, ifelse((prevStateNo = [1000, 2999]) && !map(customcombo), 2, 1))}
	mapSet{map: "combocheck"; value: 0}
}

# Cancel Flags
persistent(0) ignoreHitPause if time <= 0 {
	mapSet{map: "supercancelflag"; value: (prevStateNo = [1000, 2999] && map(supercancel) && !map(customcombo))}
	mapSet{map: "hypercancelflag"; value: (prevStateNo = [3000, 4999] && map(hypercancel))}
}

# Super Cancel Flash
ignoreHitPause if time % 2 && time = [1, 11]
&& (map(supercancelflag) || map(hypercancelflag)) {
	palFx{time: 1; add: 255, 255, 255}
	map(juggle_count) := 0;
}

# Custom Combo End
if !time && map(customcombo) > 0 {
	mapSet{map: "customcombo"; value: 0}
	mapSet{map: "juggle_count"; value: 0}
	palFx{time: 1}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_super) := 1;
	map(cmd_erase_completed) := 1;
}

# Sound
if time = 3 {
	playSnd{value: 3, 5; channel: 0}
}

# Super Pause FX
if map(cfg_superfx)
&& time = 3 {
	helper{
		helpertype: normal;
		stateno: 8510;
		id: 8500;
		name: "Superpause FX";
		posType: p1;
		pos: ceil(-18 * const(size.xscale)), ceil(-126 * const(size.yscale));
		supermovetime: 255;
		size.xscale: 1;
		size.yscale: 1;
		ownpal: 1;
	}
}

# Super Pause
if time = 3 {
	superpause{
		time: 43;
		movetime: 43;
		anim: ifelse(map(cfg_superfx), -1, 101);
		pos: ceil(-18 * const(size.xscale)), ceil(-126 * const(size.yscale));
		sound: s0, 8510;
		p2defmul: 1;
		darken: !map(cfg_superfx);
	}
}

# NHB
if animElemTime(16) < 0 {
	notHitBy{time: 1; value: SCA}
}

# Push
ignoreHitPause if animElemTime(17) < 0 {
	playerPush{value: 0}
}

# Aura
if animElem = 4 {
	helper{
		helpertype: normal;
		stateno: 4203;
		id: 4203;
		name: "KKZ Aura";
		posType: p1;
		size.xscale: 0.5;
		size.yscale: 0.5;
		ownpal: 1;
		supermovetime: cond(numEnemy, (p2, pausetime), 60);
	}
}

# Shake
if animElemTime(15) = 0 {
	envshake{
		time: 32;
		freq: 180;
		ampl: 6;
		decay: 1.0;
	}
}

# Sound
if animElem = 12 {
	playSnd{value: 4, 6; channel: 0}
}

# Sound
if animElem = 15 {
	playSnd{value: 5, 15}
}

# KKZ
if animElemTime(15) = 0 {
	helper{
		helpertype: normal; # projectile
		stateno: 4205;
		id: 4205;
		name: "KKZ Center";
		posType: p1;
		pos: -4, 8;
		size.xscale: 0.5;
		size.yscale: ifelse((screenpos y / cameraZoom) <= 456, 0.5, 0.5 + ((screenpos y / cameraZoom) - 456) / 456.0);
		ownpal: 1;
	}
}

if animElemTime(15) = 12 {
	# KKZ
	helper{
		helpertype: normal; # projectile
		stateno: 4206;
		id: 4206;
		name: "KKZ Side";
		posType: p1;
		pos: 0, 0;
		facing: 1;
		size.xscale: 0.5;
		size.yscale: 0.5;
		ownpal: 1;
	}
	# KKZ
	helper{
		helpertype: normal; # projectile
		stateno: 4206;
		id: 4206;
		name: "KKZ Side";
		posType: p1;
		pos: 0, 0;
		facing: -1;
		size.xscale: 0.5;
		size.yscale: 0.5;
		ownpal: 1;
	}
	# Shockwave Back
	explod{
		anim: 4207;
		id: 4207;
		posType: p1;
		sprPriority: -3;
		scale: 0.5, 0.5;
		trans: addAlpha;
		alpha: 192, 256;
		ownpal: 1;
	}
	# Shockwave Back
	explod{
		anim: 4207;
		id: 4207;
		posType: p1;
		facing: -1;
		sprPriority: -3;
		scale: 0.5, 0.5;
		trans: addAlpha;
		alpha: 192, 256;
		ownpal: 1;
	}
}

# Dust
if animElemTime(15) = 1 {
	helper{
		helpertype: normal;
		stateno: 4210;
		id: 4210;
		name: "Ground Impact";
		posType: p1;
		pos: -8, 0;
		ownpal: 1;
	}
}

if animElem = 15 {
	# FX - Circle
	explod{
		anim: 4211;
		id: 4211;
		posType: p1;
		pos: -4, 8;
		xangle: 80;
		projection: perspective2;
		sprPriority: -10;
	}
	# FX - Ten
	explod{
		anim: 4212;
		id: 4212;
		posType: p1;
		pos: -4, 12;
		facing: facing;
		xangle: 75;
		projection: perspective2;
		sprPriority: -10;
	}
}

# Idle
persistent(0) if animElemTime(17) >= 0 {
	stateTypeSet{moveType: I}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

