;-----------------------------------------------------------
; ダッシュ
[Statedef 100]
type = S
physics = N
anim = 100
velset = 0,0
ctrl = 1

[State 100, 1]
type = VelSet
trigger1 = time = 0
x = const(velocity.run.fwd.x)

[State 100, 2]
type = Veladd
trigger1 = vel x > .32
x = -.32

[State 100, 3]
type = Velset
trigger1 = vel x <= .32
x = 0

[State 100, 4] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 5] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 6]
type = PlaySnd
trigger1 = Time = 12
value = 0, 3

[State 100, 7]
type = PlaySnd
trigger1 = Time = 1
value = 200 + var(30), 0
channel = 0

[State 100, 8]
type = Explod
trigger1 = time = [2,16]
trigger1 = Timemod = 2, 0
anim = 110 + random % 5
postype = p1
pos = -40, -50
vel = -3, 0
random = 20, 80
removetime = 14
sprpriority = 2
ownpal = 1

[State 100, 9]
type = Explod
trigger1 = time >= 10
trigger1 = Timemod = 4, 2
anim = 115
postype = p1
pos = 0, 0
vel = -.5, 0
removetime = 13
sprpriority = 2
ownpal = 1

[State 100, 10]
type = ChangeState
trigger1 = command = "holddown"
value = 10
ctrl = 1

[State 100, 11]
type = ChangeState
trigger1 = command = "holdup"
value = 40

[State 100, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

