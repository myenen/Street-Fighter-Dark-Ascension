; Definition file for player
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Guile"        ;Name of character
displayname = "Guile" ;Name of character to display
versiondate = 10/27/2025   ;Version date of character
mugenversion = 1.1  ;Version of M.U.G.E.N character works on
