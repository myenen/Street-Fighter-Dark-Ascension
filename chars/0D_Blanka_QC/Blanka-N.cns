trigger1 = animelem = 2
value = 0, 0
channel = 1

[State 240, ヒット定義]
type = HitDef
trigger1 = Time = 0
attr = S, NA
animtype  = Light
ground.type = High
damage    = 40
guardflag = M
pausetime = 10,10
sparkno = S30000
guard.sparkno = S30021
sparkxy = ceil(-10*const(size.xscale)),ceil(-80*const(size.yscale))
hitsound   = S1,0
guardsound = S2,0
ground.slidetime = 10
ground.hittime  = 14
ground.velocity = -6
air.velocity = -3,-4
getpower = 20
givepower = 0

[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
