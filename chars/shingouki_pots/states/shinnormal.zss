#============================================================
[StateDef 800;
	type: S;
	physics: S;
	moveType: A;
	velSet: 0, 0;
	ctrl: 0;
	anim: 800;
	sprPriority: 2;
	facep2: 1;
	powerAdd: 0;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "cmd_erase_completed"; value: 1}
}

# Strength
if !time
&& !AIlevel {
	mapSet{
		map: "strength";
		value: ifelse(map(cmd_strength_bc), 3, ifelse(map(cmd_strength_yz), 1, ifelse(map(cmd_strength_ab) || map(cmd_strength_ac), 2, 0)));
	}
}

# Strength
if !time
&& AIlevel {
	mapSet{map: "strength"; value: (random % 4)}
}

# Tech Hit
mapSet{map: "throwtech_timer"; value: 0}

# Tech Hit
if numEnemy
&& p2stateType = S
&& (p2stateno = [0, 999] && p2stateno != [100, 119] && p2stateno != [200, 799] && p2, anim != 5300) {
	mapSet{map: "throwtech_timer"; value: 7}
}

# Tech Hit Facing
if !time {
	mapSet{map: "throwtech_facing"; value: facing}
}

# No proximity block
attackdist{value: 0}

# Hit
if animElem = 2
&& (!map(unthrowable) && !map(grabbehind))
&& map(truebodydistx) <= 27 {
	hitdef{
		id: 800;
		attr: S, NT;
		hitflag: M;
		priority: 1, Miss;
		guard.dist: 0;
		fall: 1;
		fall.recover: 0;
		down.recover: 1;
		hitsound: s2, 800;
		hitsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 0);
		numhits: 0;
		p1facing: 1;
		p1stateno: ifelse((!AIlevel && command = "holdfwd") || (AIlevel && stagefrontedgedist < stagebackedgedist), 803, 801);
		p2facing: 1;
		p2stateno: 802;
	}
}

# Sound
if animElem = 4 {
	playSnd{value: 5000, 2; channel: 0}
	playSnd{value: 1, 1; stopongethit: 1; freqmul: 0.95 + (random / 10000.0)}
}

# Idle
persistent(0) if animElemTime(3) >= 0 {
	stateTypeSet{moveType: I}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#----- PLAYER -----

#============================================================
# State 801
#============================================================
