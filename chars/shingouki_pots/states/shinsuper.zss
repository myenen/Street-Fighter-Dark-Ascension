		anim: 7106;
		posType: p1;
		pos: 0, -pos y;
		sprPriority: 3;
		scale: 0.5, 0.5;
		facing: 1;
		ownpal: 1;
		bindtime: 0; # Ikemen fix?
		pausemovetime: p2, pausetime;
		supermovetime: p2, pausetime;
	}
	# Type
	stateTypeSet{stateType: A; physics: N}
}

# Type
if animElemTime(8) >= 0 {
	veladd{y: 0.5}
}

# Idle
persistent(0) if animElemTime(8) >= 0 {
	stateTypeSet{moveType: I}
}

# Land
