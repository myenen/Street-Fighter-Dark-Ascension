; CNS difficulty: easy
[Statedef 195]
type = S
ctrl = 0
anim = 195
velset = 0,0
movetype = I
physics = S
sprpriority = 2

[State 195, Laugh]
type = PlaySnd
trigger1 = time = 0
value = 195,1
channel = 0

[State 195, 2]
