[Statedef 3080]
type = A
movetype = I
physics = N
ctrl = 0
anim = 3
velset = 0,0

;-------------------------------------------
;Anim
[State 3080, Stop2]
type = ChangeAnim
triggerall = Anim != 3
trigger1 = command != "holdfwd" && command != "holdback"
trigger1 = command != "holdup"
trigger2 = command != "holdfwd" && command != "holdback"
trigger2 = command = "holddown"
value = 3

[State 3080, GoUpAnim]
type = ChangeAnim
triggerall = Anim != 34
trigger1 = var(0) != 1
trigger1 = command != "holdfwd" && command != "holdback"
trigger1 = command = "holdup" 
trigger2 = var(0) = 1
trigger2 = P2Dist Y < 0
trigger3 = var(0) = 1
trigger3 = P2Dist Y < 0
value = 34

[State 3080, GoBackAnim]
type = ChangeAnim
triggerall = Anim != 105
trigger1 = var(0) != 1
trigger1 = command = "holdback" && command != "holdup" && command != "holddown"
trigger2 = var(0) = 1
trigger2 = P2Dist X < -10
value = 105

[State 3080, GoFwdAnim]
type = ChangeAnim
triggerall = Anim != 100
trigger1 = var(0) != 1
trigger1 = command = "holdfwd" && command != "holdup" && command != "holddown"
trigger2 = var(0) = 1
trigger2 = P2Dist X > 0
value = 100

[State 3080, GoFwdAnim]
type = ChangeAnim
triggerall = Anim != 20
trigger1 = var(0) != 1
trigger1 = command = "holdfwd" && command = "holdup"
trigger2 = var(0) = 1
trigger2 = P2Dist X > 0 && vel y != 0
trigger3 = var(0) != 1
trigger3 = command = "holddown" && command = "holdfwd"
value = 20

[State 3080, GoFwdAnim]
type = ChangeAnim
triggerall = Anim != 20
trigger1 = var(0) != 1
trigger1 = command = "holdup" && command = "holdback"
trigger2 = var(0) = 1
trigger2 = P2Dist X < -10 && vel y != 0
trigger3 = var(0) != 1
trigger3 = command = "holddown" && command = "holdback"
value = 21
