#==============================================================================================
#=======================================<COMMON STATES>========================================
#==============================================================================================

#====================<STANDING>====================

#============================================================
# State 0
#============================================================
[StateDef 0;
	type: S;
	physics: S;
	moveType: I;
	velSet: 0, 0;
	sprPriority: 0;
	juggle: 0;
]

# Gone
if isHelper {
	destroySelf{removeexplods: 1}
}

# Anim
if (anim != 0 && anim != 5)
|| (anim = 5 && !animTime) {
	changeAnim{value: 0}
}

# Dead
if !alive {
	selfState{value: 5050; ctrl: 0}
}

# Not Myself
if inCustomState
&& time > 0 {
	selfState{value: 5040}
}

#====================<CROUCHING>====================

#============================================================
# State 10
#============================================================
[StateDef 10;
	type: C;
	physics: C;
	moveType: I;
	velSet: 0, 0;
	sprPriority: 0;
]

# Anim
if !time {
	if anim = 12
	|| anim = 47 {
		changeAnim{value: 10; elem: 3 - animElemno(0)}
	}
}

# Anim
if anim != 10 {
	changeAnim{value: 10}
}

# End
if !animTime {
	selfState{value: 11}
}

#============================================================
# State 11
#============================================================

[StateDef 11;
	type: C;
	physics: C;
	moveType: I;
	anim: 11;
	velSet: 0, 0;
	sprPriority: 0;
]

# Anim
if anim = 6
&& !animTime {
	changeAnim{value: 11}
}

#============================================================
# State 12
#============================================================

[StateDef 12;
	type: S;
	physics: S;
	moveType: I;
	velSet: 0, 0;
	sprPriority: 0;
]

# Anim
if !time
&& anim = 10 {
	changeAnim{value: 12; elem: 3 - animElemno(0)}
}

# Anim
if anim != 12 {
	changeAnim{value: 12}
}

# End
if !animTime {
	selfState{value: 0}
}

#====================<WALKING>====================

#============================================================
# State 20
#============================================================
[StateDef 20;
	type: S;
	physics: S;
	moveType: I;
	sprPriority: 0;
]

# Vel
if command = "holdfwd" {
	velSet{x: const(velocity.walk.fwd.x)}
}

# Vel
if command = "holdback" {
	velSet{x: const(velocity.walk.back.x)}
}

# Anim
if vel x > 0 {
	if (anim != 5 && anim != 12 && anim != 20)
	|| (anim = 5 && !animTime)
	|| (anim = 12 && !animTime) {
		changeAnim{value: 20}
	}
}

# Anim
if vel x < 0 {
	if (anim != 5 && anim != 12 && anim != 21)
	|| (anim = 5 && !animTime)
	|| (anim = 12 && !animTime) {
		changeAnim{value: 21}
	}
}

#===================<JUMPING>================

#----- JUMP START -----
#============================================================
# State 40
#============================================================
[StateDef 40;
	type: S;
	physics: S;
	moveType: I;
	anim: 40;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 1;
	facep2: (prevStateNo != 100);
]

# Keyboard Check
# Currently Obsolete in Ikemen
if !time
&& !AIlevel
&& prevStateNo = 52
&& (command = "holddown" && command = "holdup") {
	changeState{value: 10; ctrl: 1}
}

# Direction
if !time {
	varSet{sysv: 1; value: 0}
}

# Direction
persistent(0) if !AIlevel
&& time >= 1
&& (command = "holdfwd" || command = "holdback") {
	varSet{sysv: 1; value: (command = "holdfwd") - (command = "holdback")}
}

# Direction
if AIlevel {
	varSet{
		sysv: 1;
		value: ifelse(p2BodyDist x < 30, 0, ifelse((life - p2life) > 200 && p2moveType != H && random < 333, -1, 1));
	}
}

# Direction AI Aerial Rave
if AIlevel
&& prevStateNo = 420 {
	varSet{sysv: 1; value: 1}
}

# High Jump
if !time {
	mapSet{map: "jumptype"; value: 0}
}

# High Jump
if !time
&& !AIlevel
&& map(cmd_highjump) {
	mapSet{map: "jumptype"; value: 3}
}

# High Jump
if !time
&& AIlevel
&& (p2BodyDist x > 80 && p2stateType != L)
&& random < 333 {
	mapSet{map: "jumptype"; value: 3}
}

# Running Jump
if prevStateNo = 100 {
	mapSet{map: "jumptype"; value: 3}
	varSet{sysv: 1; value: 1}
}

# Low Jump
if !AIlevel
&& command != "holdup"
&& map(jumptype) != [1, 2] {
	mapSet{map: "jumptype"; value: ifelse((map(jumptype) = 3 && sysvar(1)), 2, 1)}
}

# Low Jump
if AIlevel
&& !animTime
&& map(jumptype) != [1, 2]
&& (p2stateType = S || p2stateType = C)
&& p2BodyDist x < 70
&& random < ifelse(sysvar(1) = 1, 500, 125)
&& random < ifelse(p2stateType = C, 500, 250) {
	mapSet{map: "jumptype"; value: ifelse((map(jumptype) = 3 && sysvar(1)), 2, 1)}
}

# Jump Cancel
if prevStateNo = 420 {
	mapSet{map: "jumptype"; value: 3}
	mapSet{map: "juggle_count"; value: 0}
}

if !animTime {
	# Sound
	playSnd{value: 0, ifelse(map(jumptype) = [2, 3], 41, 40)}
	# Dust
	helper{
		helpertype: normal;
		stateno: 7100;
		id: 7100;
		name: "Jump Dust";
		posType: p1;
		ownpal: 1;
	}
	# Vel Normal
	velSet{
		x: ifelse(!sysvar(1), const(velocity.jump.neu.x), ifelse(sysvar(1) = 1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)));
		y: const(velocity.jump.y);
	}
}

# Vel Short
if !animTime && map(jumptype) = 1 {
	velSet{
		x: ifelse(!sysvar(1), const(velocity.jump.neu.x), ifelse(sysvar(1) = 1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)));
		y: 0.75 * const(velocity.jump.y);
	}
}

# Vel Medium
if !animTime && map(jumptype) = 2 {
	velSet{
		x: ifelse(!sysvar(1), const(velocity.jump.neu.x), ifelse(sysvar(1) = 1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)));
		y: 0.75 * const(velocity.jump.y);
	}
}

# Vel Long
if !animTime && map(jumptype) = 3 {
	velSet{
		x: ifelse(!sysvar(1), const(velocity.jump.neu.x), ifelse(sysvar(1) = 1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)));
		y: ifelse(!sysvar(1), const(velocity.runjump.y), const(velocity.jump.y));
	}
}

# End
if !animTime {
	selfState{value: 50; ctrl: 1}
}

#----- JUMP UP -----

#============================================================
# State 50
#============================================================
[StateDef 50;
	type: A;
	physics: N;
	moveType: I;
	sprPriority: 1;
]

# Anim
persistent(0) if !time {
	changeAnim{value: ifelse(!vel x, 41, ifelse(vel x > 0, 42, 43)) + 10 * (map(jumptype) = [1, 2])}
}

# No Guard
if map(jumptype) = 1 || map(jumptype) = 2 {
	assertSpecial{flag: noairguard}
}

# Grounded Frame
if time < 1 && prevStateNo = 40 {
	posfreeze{value: 1}
}

# Accel
if time >= 1 || prevStateNo != 40 {
	gravity{}
}

# Land
if vel y > 0
&& pos y > -vel y {
	selfState{value: 52}
}

#----- JUMP FALL -----

#============================================================
# State 51
#============================================================
[StateDef 51;
	type: A;
	physics: N;
	moveType: I;
	sprPriority: 1;
]

# Accel
gravity{}

# Land
if vel y > 0
&& pos y > -vel y {
	selfState{value: 52}
}

#----- JUMP LAND -----

#============================================================
# State 52
#============================================================
[StateDef 52;
	type: S;
	physics: S;
	moveType: I;
	anim: 47;
	ctrl: 1; # State -1 only sees this in the next frame
	velSet: 0, 0;
	sprPriority: 1;
]

# Pos
posSet{y: 0}

# Hop Recovery
if !time
&& (map(jumptype) = 1 || map(jumptype) = 2)
&& prevStateNo = [600, 699] {
	changeAnim{value: 57}
}

# Hop Recovery
if !time
&& anim = 57 {
	ctrlset{value: 0}
}

# Disable Trip Guard
if !time
&& (prevStateNo != [5000, 5999] && prevmoveType != H)
&& (prevStateNo != 50 && prevStateNo != 51 && prevStateNo != [120, 155])
&& prevStateNo != 703 { # Air parry
	assertSpecial{flag: nostandguard; flag2: nocrouchguard; flag3: noairguard}
}

# Trip Guard
if !time
&& ctrl
&& inguarddist
&& isAsserted(nostandguard) = 0
&& isAsserted(nocrouchguard) = 0 {
	if (!AIlevel
	&& command = "holdback")
	|| (AIlevel
	&& random < (1000 * (AIlevelF / 8.0))) {
		changeState{value: 120}
	}
}

# No Walk
if animTime
&& anim != 5 {
	assertSpecial{flag: nowalk}
}

if !time {
	# Sound
	playSnd{value: 0, 52}
	# Dust
	explod{
		anim: 7102;
		sprPriority: -5;
		posType: p1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#======================<RUN>===========================

#============================================================
# State 100
#============================================================
[StateDef 100;
	type: S;
	moveType: I;
	physics: S;
	velSet: 0, 0;
	anim: 100;
	ctrl: 0;
	sprPriority: 1;
]

if !time {
	# Sound
	playSnd{value: 0, 100}
	# Dust
	helper{
		helpertype: normal;
		stateno: 7104;
		id: 7100;
		name: "Dash Dust";
		posType: p1;
		pausemovetime: 255;
		supermovetime: 255;
		ownpal: 1;
	}
}

# Pos
posSet{y: 0}
# Vel
velSet{x: const(velocity.run.fwd.x)}

# steps
if animElem = 3 || animElem = 6 {
	playSnd{value: 0, ifelse((animElem = 3), 103, 106)}
}

# Jump
if !AIlevel
&& (command = "holdfwd" && command = "holdup") {
	changeState{value: 40}
}

# Jump
if AIlevel
&& random < 25 {
	changeState{value: 40}
}

# End
if time >= 9 {
	if (!AIlevel
	&& (command != "holdfwd" || command = "holdback"))
	|| (AIlevel && (p2moveType = A || p2dist x < 80))
	|| p2dist x < -const(size.ground.back) {
		changeState{value: 101}
	}
}

#----- STOP -----

#============================================================
# State 101
#============================================================
[StateDef 101;
	type: S;
	physics: S;
	moveType: I;
	anim: 101;
	ctrl: 0;
	sprPriority: 1;
]

if !time {
	# Sound
	playSnd{value: 0, 101}
	# Dust
	explod{
		anim: 7103;
		sprPriority: 3;
		posType: p1;
		pos: 0, 0;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# Jump
if !AIlevel
&& command = "holdup" {
	changeState{value: 40}
}

# End
if !animTime {
	changeState{value: ifelse(command = "holddown", 10, 0); ctrl: 1}
}

#========================<FORWARD DASH>==========================

#============================================================
# State 102
#============================================================
[StateDef 102;
	type: S;
	physics: N;
	moveType: I;
	velSet: 0, 0;
	anim: 102;
	ctrl: 0;
	sprPriority: 1;
]

# Run
if !time {
	varSet{sysv: 1; value: 1}
}

# Run
if time <= 5 {
	if (!AIlevel
	&& command != "holdfwd")
	|| (AIlevel && p2BodyDist x < 120) {
		varSet{sysv: 1; value: 0}
	}
}

# Run
if time = 5 && sysvar(1) {
	changeState{value: 100}
}

# Freeze
if time <= 1
|| (time < 5
&& sysvar(1) = 1) {
	changeAnim{value: 102; elem: 1}
}

# Vel
if vel x {
	veladd{x: -0.50}
}

if animElem = 2 {
	# Vel
	velSet{x: 11.00; y: 0}
	# Sound
	playSnd{value: 0, 102}
	# Dust
	helper{
		helpertype: normal;
		stateno: 7104;
		id: 7100;
		name: "Dash Dust";
		posType: p1;
		pausemovetime: 255;
		supermovetime: 255;
		ownpal: 1;
	}
}

# End
if !animTime {
	changeState{value: 103}
}

#----- LAND -----

#============================================================
# State 103
#============================================================
[StateDef 103;
	type: S;
	physics: S;
	ctrl: 1;
	anim: 103;
	velSet: 0, 0;
]

# Pos
posSet{y: 0}

if !time {
	# Sound
	playSnd{value: 0, 103}
	# Dust
	explod{
		anim: 7102;
		sprPriority: -3;
		posType: p1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#========================<BACK DASH>==========================

#============================================================
# State 105
#============================================================
[StateDef 105;
	type: A;
	physics: N;
	moveType: I;
	velSet: 0, 0;
	anim: 105;
	ctrl: 0;
	sprPriority: 1;
]

# Vel
if vel x {
	veladd{x: 0.50}
}

if animElem = 2 {
	# Vel
	velSet{x: const(velocity.run.back.x); y: const(velocity.run.back.y)}
	# Sound
	playSnd{value: 0, 105}
	# Dust
	helper{
		helpertype: normal;
		stateno: 7104;
		id: 7100;
		name: "Dash Dust";
		posType: p1;
		facing: -1;
		pausemovetime: 255;
		supermovetime: 255;
		ownpal: 1;
	}
}

# End
if !animTime {
	changeState{value: 106}
}

#----- LAND -----

#============================================================
# State 106
#============================================================
[StateDef 106;
	type: S;
	physics: S;
	ctrl: 0;
	anim: 106;
	velSet: 0, 0;
]

# Pos
posSet{y: 0}

if !time {
	# Sound
	playSnd{value: 0, 106}
	# Dust
	explod{
		anim: 7102;
		sprPriority: -3;
		posType: p1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# Ctrl
if time >= 2 {
	ctrlset{value: 1}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#========================<GUARD>========================

#----- START -----
#============================================================
# State 120
#============================================================
[StateDef 120;
	type: U;
	physics: U;
]

# Do or do not
assertSpecial{flag: nostandguard; flag2: nocrouchguard; flag3: noairguard}

# AI Tranquilizer
if AIlevel {
	assertSpecial{flag: nohardcodedkeys}
}

# Type
if !time
&& stateType = S {
	stateTypeSet{physics: S}
}

# Type
if !time
&& stateType = C {
	stateTypeSet{physics: C}
}

# Type
if !time
&& stateType = A {
	stateTypeSet{physics: A}
}

# Vel
if !time
&& stateType != A {
	velSet{x: 0; y: 0}
}

# High to Low
if stateType = S {
	if (!AIlevel
	&& command = "holddown")
	|| (AIlevel
	&& !map(ai_blockhigh)) {
		stateTypeSet{stateType: C; physics: C}
	}
}

# Low to High
if stateType = C {
	if (!AIlevel
	&& command != "holddown")
	|| (AIlevel
	&& map(ai_blockhigh)) {
		stateTypeSet{stateType: S; physics: S}
	}
}

# Anim
if !time {
	changeAnim{value: 120 + (stateType = C) + (stateType = A) * 2}
}

# End
if !animTime {
	changeState{value: 130 + (stateType = C) + (stateType = A) * 2}
}

# Stop Guarding
if stateType != A {
	if !inguarddist
	|| (!AIlevel
	&& p2dist x >= 0
	&& (command != "holdback" || command = "holdfwd"))
	|| (!AIlevel
	&& p2dist x < 0
	&& (command != "holdfwd" || command = "holdback"))
	|| ((AIlevel && numEnemy)
	&& p2, hitdefattr = SCA, AT) {
		changeState{value: 140}
	}
}

# No Walking
if ctrl {
	if (p2dist x >= 0
	&& command != "holdfwd")
	|| (p2dist x < 0
	&& command != "holdback") {
		assertSpecial{flag: nowalk}
	}
}

#----- STAND GUARD (Guarding) -----

#============================================================
# State 130
#============================================================
[StateDef 130;
	type: S;
	physics: S;
	velSet: ifelse(prevStateNo = 132 && abs(vel x) < 5, 0, vel x), 0;
]

# Do or do not
assertSpecial{flag: nostandguard; flag2: nocrouchguard}

# AI Tranquilizer
if AIlevel {
	assertSpecial{flag: nohardcodedkeys}
}

# Anim
if anim != 130 {
	changeAnim{value: 130}
}

# AI fix
if AIlevel
&& numEnemy
&& (time >= 120 || p2, time >= 60)
&& random < 17 {
	changeState{value: 40}
}

if !time
&& (prevStateNo = 132 || (prevStateNo = [154, 155])) {
	# Sound
	playSnd{value: 0, 52}
	# Dust
	explod{
		anim: 7102;
		sprPriority: -3;
		posType: p1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# High to Low
if (!AIlevel
&& command = "holddown")
|| (AIlevel
&& !map(ai_blockhigh)) {
	changeState{value: 131}
}

# Stop Guarding
if !inguarddist
|| (!AIlevel
&& p2dist x >= 0
&& (command != "holdback" || command = "holdfwd"))
|| (!AIlevel
&& p2dist x < 0
&& (command != "holdfwd" || command = "holdback"))
|| ((AIlevel && numEnemy)
&& p2, hitdefattr = SCA, AT) {
	changeState{value: 140}
}

# No Walking
if ctrl {
	if (p2dist x >= 0
	&& command != "holdfwd")
	|| (p2dist x < 0
	&& command != "holdback") {
		assertSpecial{flag: nowalk}
	}
}

#----- CROUCH GUARD (Guarding) -----

#============================================================
# State 131
#============================================================
[StateDef 131;
	type: C;
	physics: C;
	velSet: ifelse(prevStateNo = 132 && abs(vel x) < 5, 0, vel x), 0;
]

# Do or do not
assertSpecial{flag: nostandguard; flag2: nocrouchguard}

# AI Tranquilizer
if AIlevel {
	assertSpecial{flag: nohardcodedkeys}
}

# Anim
if anim != 131 {
	changeAnim{value: 131}
}

# Low to High
if (!AIlevel
&& command != "holddown")
|| (AIlevel
&& map(ai_blockhigh)) {
	changeState{value: 130}
}

# AI fix
if AIlevel
&& numEnemy
&& (time >= 120 || p2, time >= 60)
&& random < 17 {
	changeState{value: 40}
}

# Stop Guarding
if !inguarddist
|| (!AIlevel
&& p2dist x >= 0
&& (command != "holdback" || command = "holdfwd"))
|| (!AIlevel
&& p2dist x < 0
&& (command != "holdfwd" || command = "holdback"))
|| ((AIlevel && numEnemy)
&& p2, hitdefattr = SCA, AT) {
	changeState{value: 140}
}

#----- AIR GUARD (Guarding) -----

#============================================================
# State 132
#============================================================
[StateDef 132;
	type: A;
	physics: N;
]

# Do or do not
assertSpecial{flag: noairguard}

# AI Tranquilizer
if AIlevel {
	assertSpecial{flag: nohardcodedkeys}
}

# Anim
if anim != 132 {
	changeAnim{value: 132}
}

# Accel
veladd{y: const(movement.yaccel)}
# Var
varSet{sysv: 0; value: vel y > 0 && (pos y > -vel y)}

if sysvar(0) {
	# Vel
	velSet{y: 0}
	# Pos
	posSet{y: 0}
}

# End
if sysvar(0) && inguarddist {
	if (!AIlevel
	&& ifelse(p2dist x < 0, command = "holdfwd", command = "holdback"))
	|| AIlevel {
		changeState{value: 130}
	}
}

# End
if sysvar(0) {
	changeState{value: 52}
}

#----- GUARD (End) -----

#============================================================
# State 140
#============================================================
[StateDef 140;
	type: U;
	physics: U;
	ctrl: 1;
]

# Type
if !time
&& stateType = S {
	stateTypeSet{physics: S}
}

# Type
if !time
&& stateType = C {
	stateTypeSet{physics: C}
}

# Type
if !time
&& stateType = A {
	stateTypeSet{physics: A}
}

# High to Low
if stateType = S {
	if (!AIlevel
	&& command = "holddown")
	|| (AIlevel
	&& !map(ai_blockhigh)) {
		stateTypeSet{stateType: C; physics: C}
	}
}

# Low to High
if stateType = C {
	if (!AIlevel
	&& command != "holddown")
	|| (AIlevel
	&& map(ai_blockhigh)) {
		stateTypeSet{stateType: S; physics: S}
	}
}

# Anim
if !time {
	changeAnim{value: 140 + (stateType = C) + (stateType = A) * 2}
}

# No Walking
if ctrl {
	if (p2dist x >= 0
	&& command != "holdfwd")
	|| (p2dist x < 0
	&& command != "holdback") {
		assertSpecial{flag: nowalk}
	}
}

# End
if !animTime {
	changeState{value: (stateType = C) * 11 + (stateType = A) * 51}
}

#----- STAND GUARD HIT (Shaking) -----

#============================================================
# State 150
#============================================================
[StateDef 150;
	type: S;
	physics: N;
	moveType: H;
	velSet: 0, 0;
]

# Stop Snd
if !time {
	stopsnd{channel: 0}
}

# Anim
changeAnim{value: 150}

# End
if hitshakeover {
	changeState{
		value: ifelse((!AIlevel && command = "holddown") || (AIlevel && !map(ai_blockhigh)), 153, 151);
	}
}

# High to Low
if stateType = S {
	if (!AIlevel
	&& command = "holddown")
	|| (AIlevel
	&& !map(ai_blockhigh)) {
		stateTypeSet{stateType: C; physics: C}
	}
}

# Low to High
if stateType = C {
	if (!AIlevel
	&& command != "holddown")
