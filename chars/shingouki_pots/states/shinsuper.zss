		anim: 4303;
		id: 4303;
		sprPriority: 3;
		posType: p1;
		pos: 0, 0;
		bindtime: 1;
		removeongethit: 1;
		ownpal: 1;
	}
}

# Particles
if animElemTime(6) >= 1
&& animElemTime(7) < 0 {
	explod{
		vel: 0, -4;
		anim: 4111;
		sprPriority: -2;
		posType: p1;
		pos: 15, abs(pos y / 2);
		random: 80, abs(pos y);
		facing: -1 + (random < 500) * 2;
		scale: 0.25, 0.25;
		ownpal: 1;
	}
}

