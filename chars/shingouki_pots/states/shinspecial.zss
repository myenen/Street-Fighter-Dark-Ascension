#============================================================
[StateDef 1100;
	type: S;
	physics: N;
	moveType: A;
	anim: 1100;
	ctrl: 0;
	velSet: 0, 0;
	powerAdd: 100 * map(meterscaling);
	facep2: 1;
	sprPriority: 2;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	# Erase Inputs
	mapSet{map: "cmd_erase_completed"; value: 1}
	# Strength
	mapSet{map: "strength"; value: ifelse(map(cmd_strength_z), 2, ifelse(map(cmd_strength_y), 1, 0))}
}

# Strength AI
ignoreHitPause if AIlevel && time <= 0 {
	mapSet{map: "strength"; value: ifelse((p2moveType = H && p2stateType = A), 2, 0)}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_special) := 1;
	map(cmd_erase_completed) := 1;
}

# NHB
ignoreHitPause if anim = 1100
&& animElemTime(4) < 0 {
	notHitBy{value: SCA; time: 1}
}

# Accel
if vel x > 0 {
	veladd{x: -0.667}
}

# Accel
if vel x < 0 {
	velSet{x: 0}
}

# Accel
if (anim = 1100
&& animElemTime(4) >= 1)
|| anim = 1101 {
	veladd{y: ifelse(map(strength) = 2, 0.672, ifelse(map(strength) = 1, 0.663, 0.647))}
}

# Vel
if anim = 1100
&& animElem = 2 {
	velSet{x: ifelse(map(strength) = 2, 10.0, ifelse(map(strength) = 1, 8.0, 6.0))}
}

# Vel
if anim = 1100
&& animElemTime(4) = [0, 1] {
	velSet{y: ifelse(map(strength) = 2, -13.784, ifelse(map(strength) = 1, -10.934, -8.083))}
}

# Grounded Frame
if anim = 1100
&& animElemTime(4) = 0 {
	posfreeze{value: 1}
}

# Sound
if anim = 1100
&& animElem = 3 {
	playSnd{value: 1, 3; stopongethit: 1}
}

# Sound
if anim = 1100
&& animElemTime(4) = 1 {
	playSnd{value: 0, ifelse(map(strength) = 0, 40, 41)}
}

# Dust
if anim = 1100
&& animElem = 2 {
	explod{
		anim: 7103;
		sprPriority: 3;
		posType: p1;
		pos: 0, 0;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# Dust
if anim = 1100
&& animElemTime(4) = 1 {
	helper{
		helpertype: normal;
		stateno: 7100;
		id: 7100;
		name: "Dust";
		posType: p1;
		ownpal: 1;
	}
}

# Sound
if anim = 1100
&& animElem = 4 {
	playSnd{value: 3, 9; channel: 0}
}

# Hit
if (animElem = 2 && anim = 1100)
|| (animElem = 3 && anim = 1100) {
	hitdef{
		#id: stateNo;
		attr: S, SA;
		hitflag: MAF;
		guardflag: M;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := (ifelse(map(strength) = 2, 3, ifelse(map(strength) = 1, 2, 1)) + ifelse((animElem = 3), 1, 0)));
		damage: ifelse(map(strength) = 2, 40, ifelse(map(strength) = 1, 35, 30)), ifelse(map(strength) = 2, 10, ifelse(map(strength) = 1, 9, 8));
		dizzypoints: ifelse(map(strength) = 2, 50, ifelse(map(strength) = 1, 42, 34)) * !map(customcombo);
		getpower: ifelse(moveHit, 25, 100) * map(meterscaling), ifelse(moveguarded, 25, 50) * map(meterscaling);
		givepower: 40, 40;
		pausetime: 12, 12;
		animtype: Hard;
		fall.animtype: Hard;
		ground.type: Low;
		air.type: Low;
		ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		airguard.ctrltime: 1 + 16;
		ground.velocity: -3.0, ifelse(map(strength) = 2, -9.0, ifelse(map(strength) = 1, -7.5, -6.0));
		ground.cornerpush.veloff: 0;
		guard.velocity: -10.52;
		guard.cornerpush.veloff: 0;
		air.velocity: -3.0, ifelse(map(strength) = 2, -9.0, ifelse(map(strength) = 1, -7.5, -6.0));
		airguard.velocity: -6.00, -1.00;
		airguard.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		forcestand: 1;
		hitsound: s2, 3;
		hitsound.channel: 2;
		guardsound: s2, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8013);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := 20) * (map(sparkx.max) := 45), map(sparky) := ifelse((animElem = 2), -52, -75);
		envshake.time: 12; # special;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -2, 2);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Hit Midair
if animElem = 4 && anim = 1100 {
	hitdef{
		#id: stateNo;
		attr: A, SA;
		hitflag: MAF;
		guardflag: MA;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := ifelse(map(strength) = 2, 5, ifelse(map(strength) = 1, 4, 3)));
		damage: 50, 13;
		dizzypoints: ifelse(map(strength) = 2, 50, ifelse(map(strength) = 1, 42, 34)) * !map(customcombo);
		getpower: ifelse(moveHit, 25, 100) * map(meterscaling), ifelse(moveguarded, 25, 50) * map(meterscaling);
		givepower: 40, 40;
		pausetime: 12, 12;
		animtype: Up;
		air.animtype: Up;
		fall.animtype: Up;
		ground.type: High;
		air.type: Low;
		ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		airguard.ctrltime: 1 + 16;
		ground.velocity: -3.0, ifelse(map(strength) = 2, -9.0, ifelse(map(strength) = 1, -7.5, -6.0));
		ground.cornerpush.veloff: 0;
		guard.velocity: -10.52;
		guard.cornerpush.veloff: 0;
		air.velocity: -3.0, ifelse(map(strength) = 2, -9.0, ifelse(map(strength) = 1, -7.5, -6.0));
		airguard.velocity: -6.00, -1.00;
		airguard.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		forcestand: 1;
		hitsound: s2, 3;
		hitsound.channel: 2;
		guardsound: s2, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8013);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := 10) * (map(sparkx.max) := 30), map(sparky) := -100;
		envshake.time: 12; # special;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -2, 2);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Hit Midair Hard Anim
ignoreHitPause if moveHit = 1
&& moveHitvar(frame)
&& anim = 1100
&& animElemTime(4) >= 0
&& p2moveType = H
&& p2dist y <= -60
&& p2, getHitVar(frame)
&& p2, getHitVar(playerID) = ID {
	getHitVarset{redirectid: p2, ID; animtype: 2}
}

if anim = 1100
&& animElem = 4 {
