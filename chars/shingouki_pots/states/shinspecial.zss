		interpolation.time: ifelse(map(strength) = 2, 8, ifelse(map(strength) = 1, 6, 4));
		interpolation.alpha: 0, 256;
		sprPriority: sprPriority + 1;
		removeongethit: 1;
		removeonchangeState: 1;
		ownpal: 1;
	}
	# Type
	stateTypeSet{stateType: A; physics: N}
}

# Anim
if anim = 1100
&& animElemTime(4) > 0
&& vel y > (ifelse(map(strength) = 2, -5.3, ifelse(map(strength) = 1, -4, -2.7))) {
	changeAnim{value: 1101}
}

# Idle
if anim = 1101 {
	stateTypeSet{moveType: I}
}

# Land
if stateType = A
&& vel y > 0
&& pos y > -vel y {
	changeState{value: 1109}
}

