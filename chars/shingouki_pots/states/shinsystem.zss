	changeState{value: prevStateNo}
}

# Win
if !time
&& (command = "/x" || command = "/y" || command = "/z" || command = "/a" || command = "/b" || command = "/c") {
	changeState{
		value: ifelse((command = "/z" || command = "/c"), 183, ifelse((command = "/y" || command = "/b"), 181, 182));
	}
}

# Win
if !time {
	changeState{value: ifelse(random < 333, 181, ifelse(random < 500, 182, 183))}
}

