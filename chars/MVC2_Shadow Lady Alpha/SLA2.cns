; Jump Land

[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 192, Explod] ;jump dust down
type = Explod
trigger1 = AnimElemTime(1) = 0
trigger1 = numexplod(7013) = 0
anim = 7013
id = 7013
postype = P1
pos = 0,0
sprpriority = -1
ownpal = 0

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = prevstateno != 101
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 2]
type = ChangeAnim
triggerall = Time = 0
trigger1 = prevstateno = 101
trigger2 = prevstateno = 1300
trigger3 = prevstateno = 1310
trigger4 = prevstateno = 1320
value = 4100;ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
trigger1 = prevstateno != 101
persistent = 0
value = Anim + 3

[State 50, 4]
type = turn
trigger1 = p2dist X <= -3
trigger1 = time = 0

