		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		airguard.ctrltime: 1 + 16;
		ground.velocity: 0, 0;
		ground.cornerpush.veloff: 0;
		guard.velocity: -10.52;
		guard.cornerpush.veloff: 0;
		air.velocity: -6, -7.5;
		airguard.velocity: -6.00, -1.00;
		airguard.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 1;
		fall.recover: 0;
		down.recover: 1;
		forcestand: 1;
		hitsound: s2, 3;
