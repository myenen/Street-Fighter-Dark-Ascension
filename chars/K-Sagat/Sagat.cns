; Introduction
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0


[State 200, 1]
type = PlaySnd
trigger1 = Time = 48
value = 800, 3
channel=0
[State 0, Helper]
type = Helper
triggerall = var(53)=0
trigger1= command="start"
triggerall = numhelper(4001)<1
helpertype = normal ;player
name ="system Direction"
ID =4001
stateno =4050
pos = ceil(-50*const(size.xscale)),ceil(-190*const(size.yscale))
postype = p1    ;p2,front,back,left,right
facing = ifelse(facing=-1,-1,1)
keyctrl = 0
ownpal = 1
size.xscale=.5
size.yscale=.5
supermovetime=999
pausemovetime=999


[State 0, RemoveExplod]
type = RemoveExplod
trigger1 =command="start" ||AnimTime = 0
id =12010
[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = animtime=0 && anim!=0
value = 0

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = (AnimTime = 0  && anim!=0 &&numhelper(4001)=0) || (numhelper(4001)=0 && anim=0)
value = 0
