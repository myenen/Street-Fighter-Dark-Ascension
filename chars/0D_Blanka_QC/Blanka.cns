physics = S
ctrl = 0
anim = 102
velset = 0,0

[State 106, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 106, 4]
type = ChangeState
trigger1 = Time = 2
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; バック
[Statedef 105]
type    = A
physics = A
ctrl = 0
anim = 105
sprpriority = 1

[State 1];無敵の状態を作る
type = NotHitBy
trigger1 = Animelem = 3,<= 0
value = SCA

[State 105, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 105, 3]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 106

