;Flying Fist
[Statedef 221]
type    = S
movetype= A
physics = S
juggle  = 4
ctrl = 0
anim = 221
poweradd = 55
sprpriority = 5

[State 221,1]
type = Velset
trigger1 = 1
x = ifelse(p2dist X >= 0, 3.5*ceil((p2bodydist X+15)/30),3.5*ceil((p2bodydist X-15)/30))+ 3
y = 1.5*ceil((p2dist Y-60)/30)

[State 221,2]
type = Angleset
trigger1 = p2dist x != 0
value = atan(-(p2dist y-60) / p2dist x) * 180 / pi

[State 221,3]
type = Turn
Trigger1 = p2dist x <= 3

[State 221,4]
type = AngleDraw
trigger1 = 1

