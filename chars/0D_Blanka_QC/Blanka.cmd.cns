;------------------------------------------------------------------------------
;==============================================================================
; 技を実行するための条件の設定（ステートエントリーパート）
;==============================================================================
;------------------------------------------------------------------------------

[Statedef -1];←この行は絶対に消さないでください。必須の項目です。

;==============================================================================

;==============================================================================

;------------------------------------------------------------------------------
[State -1, トロピカルハザード]
type = ChangeState
value = 2200
triggerall = !var(59)
triggerall = command = "トロピカルハザード3"
triggerall = statetype != A
triggerall = power >= 3000
trigger1 = ctrl||((anim = 40)&&Pos Y >= 0)||((anim = 52)&&Pos Y >= 0)||((Stateno = [200,599])&&time <= 3&&statetype != A)
trigger2 = (anim = 200)&&(Animelem = 2,>= 2||movecontact)
trigger3 = (anim = 231)&&(Animelem = 3,>= 2||movecontact)
trigger4 = (anim = 400)&&(Animelem = 3,>= 2||movecontact)
trigger5 = (anim = 430)&&(Animelem = 2,>= 2||movecontact)
trigger6 = (anim = 440)&&(Animelem = 2,>= 2||movecontact)
trigger7 = (anim = 710)&&(movecontact)
;------------------------------------------------------------------------------
