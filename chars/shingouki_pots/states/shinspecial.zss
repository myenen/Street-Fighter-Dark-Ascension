		damage: 100, 25;
		dizzypoints: 100 * !map(customcombo);
		getpower: ifelse(moveHit, 25, 100) * map(meterscaling), ifelse(moveguarded, 25, 50) * map(meterscaling);
		givepower: 40, 40;
		pausetime: 12, 12;
		animtype: Hard;
		air.animtype: Diagup;
		fall.animtype: Diagup;
		ground.type: High;
