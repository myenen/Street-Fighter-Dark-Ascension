;--------------------- Variable List ----------------------

; Var(0) - GetHit Voices
; Var(2) - Tigershot variable
; Var(3) - Tigershot variable
; Var(4) - Tiger Uppercut
; Var(5) - No chain off of second hit
; Var(7) - Juggle Var
;          1: Normals
;          2: Juggleable specials
;          3: Hypers
;          4: Resets
;          5: Non Jugglable specials
; Var(8) - Juggle Count
; var(9) - something that I didn't even use but whatever.
; Var(10) - Projectile Hit Count
; Var(11) - Combo Gauge var 1
; Var(12) - Combo Gauge var 2
; Var(13) - Combo Gauge var 3
; Var(14) - Combo Gauge var 4
; Var(15) - Combo Gauge var 5
; Var(16) - Combo Gauge var 6
; Var(18) - Projectile Hit Var
; Var(20) - Projectil Hit Var
;Var(25) - normals
;Var(22) - specials
; Var(30) - AI Jumping
; Var(50) - Security
;Var(53) - pal selected
;Var(54) - pal color
; Var(57) - Combo Guage Value


;--------------------- Float Variable List ----------------------

; fVar(2) - Damage dampning


 
[Data]
life = 1050
attack = 100
defence = 100
power=4000
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = S7003
KO.echo = 0
volume = 230
IntPersistIndex = 53
FloatPersistIndex = 39

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 20;Player width (back, ground)
ground.front = 20    ;Player width (front, ground)
air.back = 17       ;Player width (back, air)
air.front = 17      ;Player width (front, air)
height = 40          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -118   ;Approximate position of head
mid.pos = -5, -72    ;Approximate position of midsection
shadowoffset = -0   ;Number of pixels to vertically offset the shadow
draw.offset = 0,1    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.67		 ; 前進速度
walk.back = -2.22   ;Walk backward
run.fwd  = 5, 0    ;Run forward (x, y)
run.back = -6,-5;Hop backward (x, y)
jump.neu = 0,-8.4   ;Neutral jumping velocity (x, y)
jump.back = -2.55    ;Jump back Speed (x, y)
jump.fwd = 2.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-6.5
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.
air.gethit.groundrecover = -.15,-3.5  ;Velocity for ground recovery state (x, y) **MUGEN 1.0**
air.gethit.airrecover.mul = .5,.2     ;Multiplier for air recovery velocity (x, y) **MUGEN 1.0**
air.gethit.airrecover.add = 0,-4.5    ;Velocity offset for air recovery (x, y) **MUGEN 1.0**
air.gethit.airrecover.back = -1       ;Extra x-velocity for holding back during air recovery **MUGEN 1.0**
air.gethit.airrecover.fwd = 0         ;Extra x-velocity for holding forward during air recovery **MUGEN 1.0**
air.gethit.airrecover.up = -2         ;Extra y-velocity for holding up during air recovery **MUGEN 1.0**
air.gethit.airrecover.down = 1.5
[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .5         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching
air.gethit.groundlevel = 15          ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -20 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 10   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -1  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = .35    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 10      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0, 20            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = .4               ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = 12          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .05

[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory1 = "You are not a warrior. You're a beginner."
victory2 = "I am not satisfied until I have the world's strongest title again!"
victory3 = "Accept your weakness. Never come here again."
victory4 = "Do not challenge what you cannot defeat."
victory5 = "It will take more than you to best me!"
victory6 = "Now who is the strongest?"
victory7 = "Hatred spares no one!"
victory8 = "How does it feel to have your body torn by my fist?"
victory9 = "I promised this scar, that I would never be defeated again!"
victory10 = "Man, beast or god... My punch smashes all into nothingness!"
victory11 = "Pathetic... Will you now beg me for your worthless existence?"
victory12 = "Your flesh is soft. My fists are invincible. Realize your agony."
victory13 = "Your weakness will not satisfy my vengeful rage!"
victory14 = "A warrior does not take a step back! A warrior takes on all challenges!"
victory15 = "Challenge me anytime! I'll always be here!"
victory16= "I despise your useless pride!"
victory17 = "My power is without question!"
victory18 = "Practice all you want! You will never be good enough to defeat me!"
victory19="You are too weak! You can't even scratch my body!"
victory20="Be satisfied that you laid your fists on the emperor!"
victory21="Fatuous fool. Challenging me with such puny strength."
victory22="Had enough, have you? This makes you now one of life's losers."
victory23="You are too weak! You cannot even entertain the idea of wounding me!"
victory24="My strength and skill kills!"
victory25="Did my kicks dizzy you or are your punches always so sloppy?"
victory26="How foolish of you to take me on! Did you not know my strength?"
victory27="I am not called the king for nothing! I could never lose to you!"
victory28="If you can get up after that, I'll happily treat you to another beating!"
victory29="Only the powerful deserve a chance to take a shot at my throne!"
victory30="Only those with the courage to face me are granted a rematch."
victory31="There is no disgrace in defeat provided that you learn from your own mistakes."
victory32="What a feeble attempt! Did you actually think you could hurt me with that?"
victory33="You have potential. We should fight again one day."
