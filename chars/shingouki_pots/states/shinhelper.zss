}

#----- Hitpause -----

#============================================================
# State 1026
#============================================================
[StateDef 1026;
	type: A;
	physics: N;
	moveType: A;
	ctrl: 0;
	sprPriority: 3;
	moveHitpersist: 1;
]

# Freeze
posfreeze{value: 1}

# Total Hits
persistent(0) ignoreHitPause {
	mapAdd{map: "fireball_hits"; value: 1}
}

# Getpower
ignoreHitPause if moveContact = 1 && numTarget {
	powerAdd{value: ifelse(moveHit && !prevStateNo, 50, 25) * root, map(meterscaling)}
}

# Burned
ignoreHitPause if moveHit
&& numTarget(1025)
&& target(1025), hitfall
&& target(1025), selfanimexist(7697)
&& (target(1025), stateno = 5000 || target(1025), stateno = 5010 || target(1025), stateno = 5020) {
	targetState{value: 7697; id: 1025}
}

# HitSound
ignoreHitPause if !time
&& moveHit {
	playSnd{value: 2, ifelse(numTarget, 12, 0); channel: 2}
}

# ProjContact
ignoreHitPause if moveContact = 1
&& p2, getHitVar(frame)
&& (p2, getHitVar(playerID) = ID || moveHitVar(playerID) = p2, ID) {
	map(projcontact) := 1;
	if root, stateno = 1020 {
		root, map(projcontact) := 1;
	}
}

# End
if map(fireball_hits) >= (map(strength) + 1) {
	changeState{value: 1027}
}

# Hit More
if time >= ifelse(numTarget, 4, 0)
&& map(fireball_hits) < (map(strength) + 1) {
	changeState{value: 1025}
}

