;---------------------------------------------------------------------------
; Triple Kung Fu Palm (hyper)
; CNS difficulty: medium
; Notes: Notice that the HitDefs in supers have "getpower = 0". This makes
;        sure KFM doesn't recharge his super guage as he hits.
;        Also, the attributes for the HitDefs is "HA" for "hyper attack",
;        ie. "attr = S, HA".
[Statedef 3000]
type    = S
movetype= A
physics = S
juggle  = 4
velset = 0,0
anim = ifelse(pos y >= 0,1210,1212)
ctrl = 0
sprpriority = 1

[State 1080, STS]
type = StateTypeSet
trigger1 = pos y < 0
statetype = A
physics = N

;-----------------------
;Super Move FX
[State 3000, Super A]
type = SuperPause
trigger1 = anim = 1210
trigger1 = AnimElem = 2
trigger2 = anim = 1212
trigger2 = AnimElem = 1
pos = ifelse(pos y >= 0,-100,-80),ifelse(pos y >= 0,-120,-150)
anim = S4005
sound = S15, 5
time = 50
movetime = 48
poweradd = -1000

[State 3000, Spark 2]
type = explod
trigger1 = time = 0
anim = 4001
id = 4001
pos = ifelse(pos y >= 0,-300,-300),ifelse(pos y >= 0,150,100)
postype = Right
sprpriority = 3
bindtime = -1
ignorehitpause = 1
scale = 3,1
removeongethit = 1
supermove = 1

