; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0
velset = 0,0



[State 750, Dust]
type = Explod
trigger1 = animelem = 12
trigger2 = animelem = 7
anim = 2
pos = 4,-96
postype = p1
sprpriority = 5
supermove = 0
bindtime = -1

[State 750, Dust]
type = Explod
trigger1 = animelem = 7
anim = 1
pos = 0,-14
postype = p1
sprpriority = 5
supermove = 0
bindtime = -1
scale = 0.9,0.9
removetime = 44

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

