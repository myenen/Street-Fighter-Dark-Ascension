}

# Kanji Back Brighten
if time <= 30
&& prevStateNo = 4010 {
	modifyexplod{
		id: 6010;
		palfx.time: 60;
		palfx.add: 255, 255, 255;
		palfx.sinadd: -255, -255, -255, 240;
	}
}

# Kanji Background
if !time
&& prevStateNo = 4010
&& (!numHelper(8690) && !numHelper(8600)) {
	helper{
		helpertype: normal;
		stateno: 8690;
		id: 8690;
		posType: left;
		ownpal: 1;
	}
}

# Sound
if time = 10
&& prevStateNo = 4010 {
	playSnd{value: 4, 12; channel: 0}
}

# Allow Round End
if time >= 120
&& roundState = [2, 3]
&& time > (fightscreenvar(round.over.hittime) + fightscreenvar(round.over.waittime) + fightscreenvar(round.over.wintime) + fightscreenvar(round.over.wintime))
&& !numHelper(8690) {
	ctrlset{value: 1}
}

