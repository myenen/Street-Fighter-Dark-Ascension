[State -3]
type = varset
trigger1 = movetype != H
trigger1 = var(20) != 0
v = 20
value = 0

;for Kikou
[State -3]
type = varset
trigger1 = movetype != A
trigger1 = var(16) != 0
v = 16
value = 0

;;For Wall Jump
[State -3]
type = varset
trigger1 = statetype = S
trigger1 = var(23) = 1
v = 23
value = 0

;;For Air Dash
[State -3]
type = varset
trigger1 = statetype = S
trigger1 = var(24) = 1
v = 24
value = 0

;This controller plays a sound everytime the player lands from a jump, or from a back-dash.

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 0, 13

