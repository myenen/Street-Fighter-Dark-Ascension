	ground.slidetime: 18;
	guard.hittime: 1 + 16;
	guard.ctrltime: 1 + 16;
	guard.slidetime: 16;
	airguard.ctrltime: 1 + 16;
	ground.velocity: -4.0, -5.25;
	ground.cornerpush.veloff: 0;
	guard.velocity: -10.52;
	air.velocity: -4.0, -5.25;
	airguard.velocity: -6.00, -1.00;
	guard.dist: const(size.proj.attack.dist);
