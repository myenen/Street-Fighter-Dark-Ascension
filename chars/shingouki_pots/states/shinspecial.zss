#======================<GOU HADOU KEN>=============================

#============================================================
# State 1000
#============================================================
[StateDef 1000;
	type: S;
	physics: S;
	moveType: A;
	anim: 1000;
	ctrl: 0;
	velSet: 0, 0;
	powerAdd: 50 * map(meterscaling);
	sprPriority: 2;
	facep2: 1;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	# Erase Inputs
	mapSet{map: "cmd_erase_completed"; value: 1}
	# Strength
	mapSet{map: "strength"; value: ifelse(map(cmd_strength_z), 2, ifelse(map(cmd_strength_y), 1, 0))}
}

# Strength AI
ignoreHitPause if AIlevel && time <= 0 {
	mapSet{
		map: "strength";
		value: ifelse(p2moveType = H || random < 500, 2, ifelse(random < 500, 1, 0));
	}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_special) := 1;
	map(cmd_erase_completed) := 1;
}

# Width
if animElemTime(5) = -1 {
	width{value: 20, 0}
}

if animElem = 5 {
	# Correct Projectile Trade
	hitBy{value2: SCA, AA, AT; time: 1}
	# Hadouken
	helper{
		helpertype: normal; # projectile
		stateno: 1005;
		id: 1005;
		name: "Hadouken";
		posType: p1;
		pos: 78, -67;
		size.xscale: 0.375;
		size.yscale: 0.375;
		ownpal: 1;
	}
}

# Sound
if animElem = 4 {
	playSnd{value: 3, 3; channel: 0}
}

# Sound
if animElem = 5 {
	playSnd{value: 5, 0}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#======================<SHAKUNETSU HADOU KEN>=============================

#============================================================
# State 1020
#============================================================
[StateDef 1020;
	type: S;
	physics: S;
	moveType: A;
	anim: 1020;
	ctrl: 0;
	velSet: 0, 0;
	powerAdd: 50 * map(meterscaling);
	sprPriority: 2;
	facep2: 1;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	# Erase Inputs
	mapSet{map: "cmd_erase_completed"; value: 1}
	# Strength
	mapSet{map: "strength"; value: ifelse(map(cmd_strength_z), 2, ifelse(map(cmd_strength_y), 1, 0))}
}

# Strength AI
ignoreHitPause if AIlevel && time <= 0 {
	mapSet{
		map: "strength";
		value: ifelse(map(ai_combowindow) = [11, 16], 0, ifelse(map(ai_combowindow) = [17, 23] || random < 500, 1, 2));
	}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_special) := 1;
	map(cmd_erase_completed) := 1;
}

# Width
if animElemTime(10) = -1 {
	width{value: 20, 0}
}

# Anim
persistent(0) if (map(strength) = 0 && animElem = 5)
|| (map(strength) = 1 && animElem = 7) {
	changeAnim{value: 1020; elem: 9}
}

if animElem = 10 {
	# Correct Projectile Trade
	hitBy{value2: SCA, AA, AT; time: 1}
	# Hadouken
	helper{
		helpertype: normal; # projectile
		stateno: 1025;
		id: 1025;
		name: "Hadouken";
		posType: p1;
		pos: 78, -67;
		size.xscale: ifelse(map(strength) = 2, 0.50, ifelse(map(strength) = 1, 0.45, 0.40));
		size.yscale: ifelse(map(strength) = 2, 0.50, ifelse(map(strength) = 1, 0.45, 0.40));
		ownpal: 1;
	}
}

persistent(0) if animElem = 3 {
	# Aura
	helper{
		helpertype: normal;
		stateno: 6000;
		id: 6000;
		name: "Aura";
		posType: p1;
		size.xscale: 0.5 * const(size.xscale);
		size.yscale: 0.5 * const(size.yscale);
		ownpal: 1;
	}
	# Sound
	playSnd{value: 3, 5; channel: 0}
}

# Sound
if animElem = 9 {
	playSnd{value: 3, 0; channel: 0}
}

# Sound
if animElem = 10 {
	playSnd{value: 5, 0}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#========================<BURNED>=============================

#============================================================
# State 7697
#============================================================
[StateDef 7697;
	type: U;
	physics: N;
	moveType: H;
	velSet: 0, 0;
]

# End
if !selfanimexist(7697) {
	selfState{value: 5020}
}

# Type
persistent(0) if stateType != A
&& (getHitVar(fall) || getHitVar(yvel) || pos y || vel y) {
	stateTypeSet{stateType: A}
}

# Anim
if !time
&& getHitVar(animtype) != [3,5] {
	changeAnim{value: ifelse((getHitVar(airtype) = 1), 5000, 5010) + getHitVar(animtype)}
}

# Anim
if !time
&& getHitVar(animtype) = [3,5] {
	changeAnim{value: 5030}
}

# Anim
if !time
&& ((getHitVar(animtype) = [4,5]) && (selfanimexist(5047 + getHitVar(animtype)))) {
	changeAnim{value: 5047 + getHitVar(animtype)}
}

# Anim
if !hitshakeover {
	changeAnim{value: anim}
}

# Anim
if hitshakeover
&& anim != 7697 {
	changeAnim{value: 7697}
}

# Accel
if hitshakeover
&& stateType = A {
	veladd{y: max(0.35, getHitVar(yaccel))}
}

# Vel
persistent(0) if hitshakeover {
	hitvelSet{x: 1; y: 1}
}

# End
if hitshakeover
&& vel y > 0
&& !hitfall {
	selfState{value: 5040}
}

# Fall Recovery
if vel y > 0
&& pos y >= const(movement.air.gethit.groundrecover.ground.threshold)
&& (alive = 1 && dizzy = 0 && dizzypoints > 0)
&& getHitVar(fall.recover)
&& command = "recovery" {
	selfState{value: 5200}
}

# End
if vel y > 0
&& pos y >= 25 {
	selfState{value: 5100}
}

