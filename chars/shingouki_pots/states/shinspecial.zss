		pausemovetime: -1;
		supermovetime: -1;
	}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#----- TARGET -----

#============================================================
# State 1355
#============================================================
[StateDef 1355;
	type: A;
	physics: N;
	moveType: H;
	ctrl: 0;
	sprPriority: 0;
]

# Anim
if !time {
	changeAnim2{value: 1355}
}

# Camera
screenBound{value: 1; movecamera: 0, 0}

# Safety
if time >= 180 {
	selfState{value: 5040}
}

#----- TARGET HIT FLOOR -----

#============================================================
# State 1356
#============================================================
[StateDef 1356;
	type: A;
	physics: N;
	moveType: H;
	ctrl: 0;
	sprPriority: 1;
]

# Anim
if !time {
	changeAnim2{value: 1356}
}

# Anim
if time = 16 {
	changeAnim{value: 5160}
}

# Accel
if time >= 16 {
	veladd{
		y: 0.4850; # yaccel
	}
}

# Vel
if time = 16 {
	velSet{x: -1.5; y: -7.5}
}

# Dizzy Start
if alive
&& life > 0
&& dizzypoints <= 0
&& !getHitVar(isbound) {
	dizzyset{value: 1}
}

# Fall Recovery
if time > 16
&& (alive = 1 && dizzy = 0 && dizzypoints > 0)
&& getHitVar(fall.recover)
&& command = "recovery"
&& vel y > 0
&& pos y >= const(movement.air.gethit.groundrecover.ground.threshold) {
	selfState{value: 5200}
}

# End
if time > 16
&& vel y > 0
&& pos y >= 0 {
	selfState{value: 5100}
}

# Bounce Offset Fix
if time >= 16 {
	offset{y: const(movement.down.bounce.offset.y)}
}

#======================<ASHURA SENKUU>=============================

#============================================================
# State 1400
#============================================================
[StateDef 1400;
	type: S;
	physics: N;
	moveType: I;
	anim: 1400;
	velSet: 0, 0;
	ctrl: 0;
	sprPriority: -1;
	facep2: 1;
]

# Strength
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{
		map: "strength";
		value: ifelse(map(cmd_623kk), 1, ifelse(map(cmd_623pp), 2, ifelse(map(cmd_421kk), -1, -2)));
	}
}

# Strength AI
ignoreHitPause if AIlevel && time <= 0 {
	mapSet{map: "strength"; value: ifelse(life > p2, life && random < 333, 1, 2)}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_special) := 1;
	map(cmd_erase_completed) := 1;
}

# Aura
persistent(0) if animElem = 3 {
	helper{
		helpertype: normal;
		stateno: 6000;
		id: 6000;
		name: "Aura";
		ownpal: 1;
		posType: p1;
		size.xscale: 0.5 * const(size.xscale);
		size.yscale: 0.5 * const(size.yscale);
	}
}

# Vel
if animElemTime(2) > 0 && animElemTime(7) < 0 {
	velSet{
		x: ifelse(map(strength) = 2, -6, ifelse(map(strength) = 1, -4, ifelse(map(strength) = -2, 6, 4))) * sin(animElemTime(2) / 8.0 * pi);
	}
}

# Vel
if animElemTime(7) > ifelse(map(strength) = 2 || map(strength) = -2, 15, 8) {
	velmul{x: 0.9}
}

# Vel
if animElem = 7 {
	velSet{
		x: ifelse(map(strength) = 2, 12.0, ifelse(map(strength) = 1, 8.33, ifelse(map(strength) = -2, -12.0, -8.33)));
	}
}

# Sound
persistent(0) if animElem = 7 {
	playSnd{value: 5, 6}
}

# Darken
if animElemTime(6) >= 0 {
	palFx{time: 1; mul: 128, 128, 128}
}

if animElemTime(7) >= 0 {
	# Afterimage
	explod{
		id: 1400;
		posType: p1;
		pos: 0, 2 * cos(time / 8.0 * pi);
		sprPriority: sprPriority - 1;
		anim: anim;
		animfreeze: 1;
		animElem: animElemno(0);
		removetime: 16;
		trans: addAlpha;
		alpha: 256, 0;
		scale: const(size.xscale), const(size.yscale);
		palfx.time: 16;
		palfx.mul: 128, 128, 128;
		interpolation.time: 16;
		interpolation.alpha: 0, 256;
		removeonchangeState: 1;
		ownpal: 1;
	}
	# Eye
	explod{
		id: 1400;
		anim: 8060;
		posType: p1;
		pos: 10 * const(size.xscale) - 0.5 * vel x, -98 * const(size.yscale);
		sprPriority: sprPriority + 1;
		removetime: 16;
		trans: addAlpha;
		alpha: 256, 256;
		scale: 0.02 * abs(vel x), 0.02;
		palfx.time: 16;
		palfx.color: 0;
		palfx.mul: 256, 0, 0;
		interpolation.time: 16;
		interpolation.alpha: 0, 256;
		removeonchangeState: 1;
		ownpal: 1;
	}
}

# Turn
if animElemTime(7) > 0
&& p2dist x < 0 {
	turn{}
}

# End
if animElemTime(7) > 0 {
	if ((time >= ifelse(map(strength) = 2 || map(strength) = -2, 49, 44)))
	|| (vel x < 0 && backedgebodydist <= 0)
	|| (vel x > 0 && frontedgebodydist <= 0) {
		changeState{value: 1401}
	}
}

# NHB
notHitBy{value: SCA, AA, AP, AT; time: 1}

# Push
if time > 0
&& animElemTime(3) >= 0 {
	playerPush{value: 0}
}

#---Recovery---

