;-------------------------------------------------------------------------------
[Statedef 194]
type = S 
physics = S
sprpriority = 0 

[State 194,1]
type = posset 
trigger1 = 1 
y = 0 

[State 194,2]
type = VelSet 
trigger1 =!Time
y = 0 

[State 194,3]
type = VelSet 
trigger1 = command = "holdfwd" 
x = 2.4 

[State 194,4]
type = VelSet 
trigger1 = command = "holdback" 
x = -2.0 

[State 194,5]
type = ChangeAnim 
trigger1 = command = "holdfwd" 
trigger1 = Anim != 20 
value = 20 

[State 194,6]
type = ChangeAnim 
trigger1 = command = "holdback" 
trigger1 = Anim != 21 
value = 21 

[State 194,7]
type = ChangeAnim 
trigger1 = command != "holdback" 
trigger1 = command != "holdfwd" 
trigger1 = Anim != 0 
value = 0 

[State 194,8]
type = VelSet 
trigger1 = command != "holdback" 
trigger1 = command != "holdfwd" 
x = 0 

[State 194,9]
type = VarSet 
trigger1 = roundstate != 2 
var(9) = floor(pos x) 

[State 194,10]
type = posset 
trigger1 = roundstate = 2 
trigger1 = var(9) != 0 
x = var(9) 

[State 194,11]
type = varset 
trigger1 = roundstate = 2 
var(9) = 0 

[State 194,12]
type = changestate 
trigger1 = ctrl 
value = ifelse((command = "holdfwd") || (command ="holdback"),20,0)

