#======================<MESSATSU GOU HADOU>=============================

#============================================================
# State 3000
#============================================================
[StateDef 3000;
	type: S;
	physics: S;
	moveType: A;
	anim: 3000;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	facep2: 1;
	powerAdd: -1000 + 0 * (map(superlevel) := 1);
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: ifelse((prevStateNo = [3000, 4999]), 3, ifelse((prevStateNo = [1000, 2999]) && !map(customcombo), 2, 1))}
	mapSet{map: "combocheck"; value: 0}
}

# Cancel Flags
persistent(0) ignoreHitPause if time <= 0 {
	mapSet{map: "supercancelflag"; value: (prevStateNo = [1000, 2999] && map(supercancel) && !map(customcombo))}
	mapSet{map: "hypercancelflag"; value: (prevStateNo = [3000, 4999] && map(hypercancel))}
}

# Super Cancel Flash
ignoreHitPause if time % 2 && time = [1, 11]
&& (map(supercancelflag) || map(hypercancelflag)) {
	palFx{time: 1; add: 255, 255, 255}
	map(juggle_count) := 0;
}

# Custom Combo End
if !time && map(customcombo) > 0 {
	mapSet{map: "customcombo"; value: 0}
	mapSet{map: "juggle_count"; value: 0}
	palFx{time: 1}
}

# Strength
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "strength"; value: ifelse(map(cmd_strength_z), 2, ifelse(map(cmd_strength_y), 1, 0))}
}

# Button AI
ignoreHitPause if AIlevel && time <= 0 {
	mapSet{map: "strength"; value: 2}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_super) := 1;
	map(cmd_erase_completed) := 1;
}

# Sound
if time = 3 {
	playSnd{value: 4, 5; channel: 0}
}

# Super Pause FX
if map(cfg_superfx)
&& time = 3 {
	helper{
		helpertype: normal;
		stateno: 8500;
		id: 8500;
		name: "Superpause FX";
		posType: p1;
		pos: ceil(-21 * const(size.xscale)), ceil(-48 * const(size.yscale));
		supermovetime: 255;
		size.xscale: 1;
		size.yscale: 1;
		ownpal: 1;
	}
}

# Super Pause
if time = 3 {
	superpause{
		time: 41;
		movetime: 41;
		anim: ifelse(map(cfg_superfx), -1, 100);
		pos: ceil(-21 * const(size.xscale)), ceil(-48 * const(size.yscale));
		sound: s0, 8500;
		p2defmul: 1;
		darken: !map(cfg_superfx);
	}
}

# NHB
if anim = 3000
|| (anim = 3001 && animElemTime(2) < 1) {
	notHitBy{attr: SCA; slot: 0; time: 1}
}

# Width
if anim = 3001
&& animElemTime(2) = -1 {
	width{value: 20, 0}
}

# Aura
persistent(0) if anim = 3000
&& animElem = 3 {
	helper{
		helpertype: normal;
		stateno: 6000;
		id: 6000;
		name: "Aura";
		posType: p1;
		size.xscale: 0.5 * const(size.xscale);
		size.yscale: 0.5 * const(size.yscale);
		supermovetime: ifelse(time < 50, 50 - time, 0);
		ownpal: 1;
	}
}

# Anim
if anim = 3000
&& time = 44 {
	changeAnim{value: 3001}
}

if anim = 3001
&& animElem = 2 {
	# Hadouken
	helper{
		helpertype: normal; # projectile
		stateno: 3005;
		id: 3005;
		name: "Hadouken";
		posType: p1;
		pos: 80, -67;
		size.xscale: 0.5;
		size.yscale: 0.5;
		ownpal: 1;
	}
	# Dust
	explod{
		anim: 7106;
		sprPriority: 3;
		posType: p1;
		pos: 42, 4;
		ownpal: 1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
	}
	# Sound
	playSnd{value: 3, 7; channel: 0}
	# Sound
	playSnd{value: 5, 0}
}

# End
if anim = 3001
&& !animTime {
	changeState{value: 0; ctrl: 1}
}

