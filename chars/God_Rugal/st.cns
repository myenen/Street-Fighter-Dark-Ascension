[StateDef 9741]
anim                = 9741
ctrl                = 0

[State 9741:        safety]  
type                = selfstate
trigger1            = !ishelper
value               = 0

[State 9741:        pausecheck]
type                = varset
trigger1            = (gametime>root,var(57))||!(root,alive)||(roundstate!=2)||root,var(58)
trigger2            = var(3):=0
var(2)              = (var(3):=1)+(var(4):=0)

[State 9741:        Facing]  
type                = turn
trigger1            = (var(9):=(facing!=root,facing))

[State 9741:        dirturnonAI]
type                = parentvarset
triggerall          = !var(3)&&!var(9)
trigger1            = (root,command="holdfwd")||(root,command="holdback")||(root,command="holdup")||(root,command="holddown")
trigger2            = !(var(4):=1)
var(58)             = var(4)

[State 9741:        dirturnoffAI]
type                = parentvarset
triggerall          = !var(3)&&parent,var(58)
trigger1            = (command="holdfwd")&&(root,command="holdfwd")
trigger2            = (command="holdback")&&(root,command="holdback")
trigger3            = (command="holdup")&&(root,command="holdup")
trigger4            = (command="holddown")&&(root,command="holddown")
var(58)             = var(4):=0

[State 9741:        buttonturnonAI]
type                = parentvarset
triggerall          = var(1)&&!var(2)
trigger1            = (root,command="a")||(root,command="b")||(root,command="c")||(root,command="x")
trigger2            = (root,command="y")||(root,command="z")||(root,command="s")
var(58)             = 1

[State 9741:        buttonturnoffAI]
type                = parentvarset
triggerall          = !var(2)
trigger1            = (command="a")&&(root,command="a")
trigger2            = (command="b")&&(root,command="b")
trigger3            = (command="c")&&(root,command="c")
trigger4            = (command="x")&&(root,command="x")
trigger5            = (command="y")&&(root,command="y")
trigger6            = (command="z")&&(root,command="z")
trigger7            = (command="s")&&(root,command="s")
var(58)             = -1

[State 9741:        unpausecheck]
type                = varset
triggerall          = var(2)
trigger1            = (root,command="a")||(root,command="b")||(root,command="c")||(root,command="x")
trigger2            = (root,command="y")||(root,command="z")||(root,command="s")
trigger3            = var(2)=2
trigger4            = var(2):=0
var(2)              = 2

[State 9741:        end]     
type                = destroyself
triggerall          = var(1):=1
trigger1            = root,var(58)
trigger2            = !(root,alive)
trigger3            = roundstate!=2
;---------------------------------------------------------------------------;

