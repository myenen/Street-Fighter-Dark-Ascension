	damage: ifelse(map(strength) = 2, 37, ifelse(map(strength) = 1, 43, 60)), ifelse(map(strength) = 2, 9, ifelse(map(strength) = 1, 11, 15));
	dizzypoints: ifelse(map(strength) = 2, 34, ifelse(map(strength) = 1, 75, 200)) * !(root, map(customcombo));
	getpower: 0, 0;
	givepower: 40, 40;
	pausetime: 0, 12;
	animtype: Hard;
